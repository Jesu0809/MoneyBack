@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Nav
@inject AuthService AuthService
@inject ThemeService ThemeService
@inject EstadoConexion Estado
@inject ColaPendientes Cola
@inject UiOverlayService UiOverlay
@inject ApiClient Api
@inject AuthenticationStateProvider AuthProvider

<AuthorizeView>
    <Authorized>
        <div class="app-shell">
            <div class="topbar @(UiOverlay.ModalPantallaCompletaAbierto ? "topbar-hidden" : "")">
                @* El punto era decorativo; ahora dice si hay línea, como el
                   LED de un router. Importa desde que la app funciona sin
                   señal: sin esto no habría forma de notar la diferencia
                   entre "quedó guardado en el servidor" y "quedó acá
                   esperando". *@
                <div class="topbar-brand">
                    <span class="dot dot-@(Estado.Actual.ToString().ToLowerInvariant())"
                          title="@Estado.Descripcion"></span>
                    <span>MoneyBack</span>
                </div>
                <div class="topbar-actions">
                    <div class="theme-toggle-track glass">
                        <button class="theme-toggle-btn @(ThemeService.Actual == Tema.Claro ? "active" : "")" @onclick="() => CambiarTema(Tema.Claro)" title="Modo claro">
                            <Icon Name="sun" Size="16" />
                        </button>
                        <button class="theme-toggle-btn @(ThemeService.Actual == Tema.Oscuro ? "active" : "")" @onclick="() => CambiarTema(Tema.Oscuro)" title="Modo oscuro">
                            <Icon Name="moon" Size="16" />
                        </button>
                    </div>
                    <button class="icon-btn notif-bell" @onclick="ToggleNotificaciones" title="Notificaciones">
                        <Icon Name="bell" Size="20" />
                        @if (TotalEnLaCampana > 0)
                        {
                            <span class="notif-badge">@TotalEnLaCampana</span>
                        }
                    </button>
                    <button class="avatar-btn" @onclick="ToggleMenu" title="@context.User.Identity?.Name">
                        @Inicial(context)
                    </button>
                </div>
            </div>

            @if (_panelNotifAbierto || _menuAbierto)
            {
                <div class="panel-telon" @onclick="CerrarPaneles"></div>
            }

            @if (_panelNotifAbierto)
            {
                @* Dos cosas distintas en un solo panel: arriba lo que pide
                   una respuesta, abajo lo que solo informa. Antes acá solo
                   vivían los cobros por confirmar y todo lo demás —topes,
                   resumen semanal, gastos que entraron solos— salía por push
                   y no dejaba rastro: si no viste la notificación, el aviso
                   nunca existió para ti. *@
                @* Flotante y no una tarjeta en el flujo: así estaba, tocar
                   la campanita con la página bajada abría el panel ARRIBA,
                   fuera de la pantalla, y parecía que el botón no servía. *@
                <div class="card panel-flotante">
                    <div class="stack">
                        <div class="row-between">
                            <strong>Notificaciones</strong>
                            <div class="row" style="gap:4px">
                                @if (_sinLeer > 0)
                                {
                                    <button class="btn btn-ghost" style="font-size:12.5px; padding:6px 10px"
                                            @onclick="MarcarTodasLeidas">Marcar todas</button>
                                }
                                <button class="icon-btn" style="width:28px;height:28px;background:transparent;border:none" @onclick="() => _panelNotifAbierto = false">
                                    <Icon Name="x" Size="16" />
                                </button>
                            </div>
                        </div>

                        @if (_errorCargando)
                        {
                            <p class="muted">No pudimos cargar tus notificaciones. <button style="background:none;border:none;padding:0;color:var(--color-accent-strong);text-decoration:underline;font:inherit;cursor:pointer" @onclick="CargarPendientesAsync">Reintentar</button></p>
                        }

                        @if (_pendientes.Count > 0)
                        {
                            <div class="label">Necesitan tu respuesta</div>
                            @foreach (var p in _pendientes)
                            {
                                <div class="stack" style="gap:8px; padding:6px 0">
                                    <div class="row">
                                        <span style="font-size:18px">@p.CategoriaIcono</span>
                                        <div>
                                            <div style="font-weight:600">@p.SuscripcionNombre</div>
                                            <div class="muted" style="font-size:12.5px">@Formato.Pesos(p.Monto) · @Formato.FechaCorta(p.PeriodoCobro)</div>
                                        </div>
                                    </div>
                                    <p class="muted" style="font-size:13px; margin:0">¿Se cobró?</p>
                                    <div class="row" style="gap:8px">
                                        <button class="btn btn-secondary" style="flex:1" @onclick="() => Resolver(p, false)">No</button>
                                        <button class="btn btn-primary" style="flex:1" @onclick="() => Resolver(p, true)">Sí</button>
                                    </div>
                                </div>
                                <div class="divider"></div>
                            }
                        }

                        @if (_notificaciones.Count > 0)
                        {
                            <div class="label">Lo que ha pasado</div>
                            @foreach (var n in _notificaciones)
                            {
                                <div class="row card-tap" style="gap:10px; align-items:flex-start; padding:9px 0"
                                     @onclick="() => AbrirNotificacion(n)">
                                    @* El punto es la única marca de "no leída":
                                       pintar la fila entera de color convierte
                                       una lista de avisos en una alarma. *@
                                    <div class="icon-bubble" style="background:var(--color-surface-2); position:relative">
                                        <Icon Name="@IconoDe(n.Tipo)" Size="16" />
                                        @if (!n.Leida)
                                        {
                                            <span class="punto-sin-leer"></span>
                                        }
                                    </div>
                                    <div style="min-width:0; flex:1">
                                        <div style="font-weight:@(n.Leida ? "500" : "650"); font-size:14px">@n.Titulo</div>
                                        <div class="muted" style="font-size:12.5px">@n.Cuerpo</div>
                                        <div class="muted" style="font-size:11.5px; margin-top:2px">@HaceCuanto(n.CreadaEn)</div>
                                    </div>
                                </div>
                            }
                        }
                        else if (_pendientes.Count == 0 && !_errorCargando)
                        {
                            <p class="muted" style="margin:0">
                                Nada por ahora. Acá van a aparecer los avisos de topes, los cobros
                                que se vienen y el resumen de cada semana.
                            </p>
                        }
                    </div>
                </div>
            }

            @if (_menuAbierto)
            {
                <div class="card panel-flotante">
                    <div class="stack">
                        <div class="row-between">
                            <div>
                                <div style="font-weight:650">@NombreDe(context)</div>
                                <div class="muted">@EmailDe(context)</div>
                            </div>
                        </div>
                        <div class="divider"></div>
                        <button class="btn btn-secondary btn-block" @onclick="IrAPerfil">
                            <Icon Name="user" Size="17" /> Perfil
                        </button>
                        <button class="btn btn-secondary btn-block" @onclick="CerrarSesion">
                            <Icon Name="logout" Size="17" /> Cerrar sesión
                        </button>
                    </div>
                </div>
            }

            <div class="page-enter">
                @Body
            </div>
        </div>

        <nav class="tabbar @(UiOverlay.ModalPantallaCompletaAbierto ? "tabbar-hidden" : "")">
            <div class="tabbar-inner">
                <NavLink class="tab-link" href="/" Match="NavLinkMatch.All">
                    <span class="tab-icon"><Icon Name="wallet" Size="21" /></span>
                    <span>Día a día</span>
                </NavLink>
                <NavLink class="tab-link" href="/hogar">
                    <span class="tab-icon"><Icon Name="home" Size="21" /></span>
                    <span>Hogar</span>
                </NavLink>
                <NavLink class="tab-link" href="/mas">
                    <span class="tab-icon"><Icon Name="archive" Size="21" /></span>
                    <span>Más</span>
                </NavLink>
                <AuthorizeView Roles="SuperAdmin" Context="adminContext">
                    <Authorized>
                        <NavLink class="tab-link" href="/admin">
                            <span class="tab-icon"><Icon Name="shield" Size="21" /></span>
                            <span>Admin</span>
                        </NavLink>
                    </Authorized>
                </AuthorizeView>
            </div>
        </nav>
    </Authorized>
    <NotAuthorized>
        <div class="page-enter">
            @Body
        </div>
    </NotAuthorized>
</AuthorizeView>

@* Fuera de .page-enter a propósito: ahí adentro quedaría atrapada debajo
   de la barra de arriba y la de abajo por más z-index que tuviera. *@
<HojaDeConfirmacion />

@code {
    private bool _menuAbierto;
    private bool _panelNotifAbierto;
    private bool _errorCargando;
    private List<ConfirmacionPendienteResponse> _pendientes = [];
    private List<NotificacionResponse> _notificaciones = [];
    private int _sinLeer;

    /// <summary>
    /// Lo que pide respuesta más lo que no se ha leído. Son dos cosas
    /// distintas pero una sola campanita: partir el número en dos badges
    /// obligaría a entender la diferencia antes de poder mirar de reojo.
    /// </summary>
    private int TotalEnLaCampana => _pendientes.Count + _sinLeer;
    private readonly CancellationTokenSource _cts = new();

    private static readonly TimeSpan IntervaloRefresco = TimeSpan.FromMinutes(2);

    /// <summary>
    /// El aviso llega desde el manejador de red, que corre fuera del ciclo de
    /// render: hay que volver al hilo de la interfaz antes de repintar.
    /// </summary>
    private void AlCambiarConexion() => _ = InvokeAsync(StateHasChanged);

    protected override async Task OnInitializedAsync()
    {
        ThemeService.OnChange += StateHasChanged;
        UiOverlay.OnChange += StateHasChanged;
        Estado.OnCambio += AlCambiarConexion;
        AuthProvider.AuthenticationStateChanged += OnAuthenticationChanged;
        await CargarPendientesAsync();

        // El LED tiene que decir la verdad desde que abre la app: si quedaron
        // gastos anotados sin señal en la sesión anterior, siguen pendientes
        // aunque ahora sí haya conexión.
        Estado.ActualizarPendientes((await Cola.ListarAsync()).Count);

        _ = SondearPendientesPeriodicamenteAsync();
    }

    /// <summary>
    /// La campanita antes solo cargaba al iniciar sesión o al abrir el
    /// panel — si llegaba un push de "cobro próximo" con la app abierta, el
    /// número no cambiaba hasta recargar. Este sondeo la mantiene al día
    /// sin necesidad de que el usuario haga nada.
    /// </summary>
    private async Task SondearPendientesPeriodicamenteAsync()
    {
        using var timer = new PeriodicTimer(IntervaloRefresco);
        try
        {
            while (await timer.WaitForNextTickAsync(_cts.Token))
            {
                await CargarPendientesAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // El layout se destruyó (Dispose) — dejar de sondear, nada que limpiar.
        }
    }

    private async void OnAuthenticationChanged(Task<AuthenticationState> _)
    {
        await CargarPendientesAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task CargarPendientesAsync()
    {
        // En paralelo: son dos consultas independientes y el panel las
        // necesita a las dos para pintarse.
        var confirmacionesTask = Api.ObtenerConfirmacionesPendientesAsync();
        var bandejaTask = Api.ObtenerNotificacionesAsync();
        await Task.WhenAll(confirmacionesTask, bandejaTask);

        var bandeja = await bandejaTask;
        if (bandeja is not null)
        {
            _notificaciones = bandeja.Notificaciones;
            _sinLeer = bandeja.SinLeer;
        }

        var resultado = await confirmacionesTask;
        if (resultado is null)
        {
            // Se deja _pendientes como estaba (el badge no desaparece de
            // golpe por un error pasajero) — solo se marca el error para
            // que el panel, si está abierto, ofrezca reintentar.
            _errorCargando = true;
            return;
        }

        _errorCargando = false;
        _pendientes = resultado;
    }

    private void ToggleMenu()
    {
        _panelNotifAbierto = false;
        _menuAbierto = !_menuAbierto;
    }

    /// <summary>
    /// Tocar una notificación la marca leída y, si lleva a algún lado, va.
    /// Se actualiza el contador en el acto y no se espera al servidor: si
    /// la petición falla, lo peor que pasa es que vuelva a salir sin leer
    /// en la próxima carga.
    /// </summary>
    private async Task AbrirNotificacion(NotificacionResponse n)
    {
        if (!n.Leida)
        {
            var i = _notificaciones.IndexOf(n);
            if (i >= 0) _notificaciones[i] = n with { Leida = true };
            _sinLeer = Math.Max(0, _sinLeer - 1);

            await Api.MarcarNotificacionLeidaAsync(n.Id);
        }

        if (!string.IsNullOrWhiteSpace(n.Url))
        {
            _panelNotifAbierto = false;
            Nav.NavigateTo(n.Url);
        }
    }

    private async Task MarcarTodasLeidas()
    {
        _notificaciones = _notificaciones.Select(n => n with { Leida = true }).ToList();
        _sinLeer = 0;
        await Api.MarcarTodasLasNotificacionesLeidasAsync();
    }

    private static string IconoDe(string tipo) => tipo switch
    {
        "Tope" => "wallet",
        "CobroFijo" => "bell",
        "Resumen" => "pie-chart",
        "GastoAutomatico" => "credit-card",
        "Invitacion" => "user",
        _ => "bell"
    };

    /// <summary>
    /// "Hace 3 horas" se entiende de un vistazo; una fecha completa obliga a
    /// restar mentalmente. Pasada la semana sí se muestra la fecha, porque
    /// "hace 23 días" ya no le dice nada a nadie.
    /// </summary>
    private static string HaceCuanto(DateTime cuando)
    {
        var minutos = (DateTime.UtcNow - cuando).TotalMinutes;

        return minutos switch
        {
            < 2 => "ahora mismo",
            < 60 => $"hace {(int)minutos} minutos",
            < 120 => "hace una hora",
            < 1440 => $"hace {(int)(minutos / 60)} horas",
            < 2880 => "ayer",
            < 10080 => $"hace {(int)(minutos / 1440)} días",
            _ => Formato.FechaCorta(cuando)
        };
    }

    private async Task ToggleNotificaciones()
    {
        // Solo uno abierto a la vez: encimados no se lee ninguno.
        _menuAbierto = false;
        _panelNotifAbierto = !_panelNotifAbierto;
        if (_panelNotifAbierto) await CargarPendientesAsync();
    }

    private void CerrarPaneles()
    {
        _panelNotifAbierto = false;
        _menuAbierto = false;
    }

    private async Task Resolver(ConfirmacionPendienteResponse pendiente, bool ocurrio)
    {
        await Api.ResolverConfirmacionAsync(pendiente.SuscripcionId, pendiente.Id, ocurrio);
        await CargarPendientesAsync();
    }

    private void IrAPerfil()
    {
        _menuAbierto = false;
        Nav.NavigateTo("/perfil");
    }

    private async Task CambiarTema(Tema tema)
    {
        var nuevo = ThemeService.Actual == tema ? Tema.Sistema : tema;
        await ThemeService.CambiarAsync(nuevo);
    }

    private static string NombreDe(AuthenticationState context) =>
        context.User.FindFirst("nombre")?.Value ?? "Tú";

    private static string EmailDe(AuthenticationState context) =>
        context.User.FindFirst("email")?.Value ?? "";

    private static string Inicial(AuthenticationState context)
    {
        var nombre = NombreDe(context);
        return nombre.Length > 0 ? nombre[..1].ToUpperInvariant() : "?";
    }

    private async Task CerrarSesion()
    {
        _menuAbierto = false;
        await AuthService.LogoutAsync();
        Nav.NavigateTo("/login", forceLoad: false);
    }

    public void Dispose()
    {
        Estado.OnCambio -= AlCambiarConexion;
        ThemeService.OnChange -= StateHasChanged;
        UiOverlay.OnChange -= StateHasChanged;
        AuthProvider.AuthenticationStateChanged -= OnAuthenticationChanged;
        _cts.Cancel();
        _cts.Dispose();
    }
}
