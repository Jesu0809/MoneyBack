@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Nav
@inject AuthService AuthService
@inject ThemeService ThemeService
@inject UiOverlayService UiOverlay
@inject ApiClient Api
@inject AuthenticationStateProvider AuthProvider

<AuthorizeView>
    <Authorized>
        <div class="app-shell">
            <div class="topbar @(UiOverlay.ModalPantallaCompletaAbierto ? "topbar-hidden" : "")">
                <div class="topbar-brand">
                    <span class="dot"></span>
                    <span>MoneyBack</span>
                </div>
                <div class="topbar-actions">
                    <div class="theme-toggle-track glass">
                        <button class="theme-toggle-btn @(ThemeService.Actual == Tema.Claro ? "active" : "")" @onclick="() => CambiarTema(Tema.Claro)" title="Modo claro">
                            <Icon Name="sun" Size="16" />
                        </button>
                        <button class="theme-toggle-btn @(ThemeService.Actual == Tema.Oscuro ? "active" : "")" @onclick="() => CambiarTema(Tema.Oscuro)" title="Modo oscuro">
                            <Icon Name="moon" Size="16" />
                        </button>
                    </div>
                    <button class="icon-btn notif-bell" @onclick="ToggleNotificaciones" title="Notificaciones">
                        <Icon Name="bell" Size="20" />
                        @if (_pendientes.Count > 0)
                        {
                            <span class="notif-badge">@_pendientes.Count</span>
                        }
                    </button>
                    <button class="avatar-btn" @onclick="ToggleMenu" title="@context.User.Identity?.Name">
                        @Inicial(context)
                    </button>
                </div>
            </div>

            @if (_panelNotifAbierto)
            {
                <div class="card" style="margin-bottom: 14px;">
                    <div class="stack">
                        <div class="row-between">
                            <strong>Cobros por confirmar</strong>
                            <button class="icon-btn" style="width:28px;height:28px;background:transparent;border:none" @onclick="() => _panelNotifAbierto = false">
                                <Icon Name="x" Size="16" />
                            </button>
                        </div>
                        @if (_errorCargando)
                        {
                            <p class="muted">No pudimos cargar tus notificaciones. <button style="background:none;border:none;padding:0;color:var(--color-accent-strong);text-decoration:underline;font:inherit;cursor:pointer" @onclick="CargarPendientesAsync">Reintentar</button></p>
                        }
                        else if (_pendientes.Count == 0)
                        {
                            <p class="muted">No hay cobros pendientes de confirmar.</p>
                        }
                        else
                        {
                            @foreach (var p in _pendientes)
                            {
                                <div class="divider"></div>
                                <div class="stack" style="gap:8px">
                                    <div class="row">
                                        <span style="font-size:18px">@p.CategoriaIcono</span>
                                        <div>
                                            <div style="font-weight:600">@p.SuscripcionNombre</div>
                                            <div class="muted" style="font-size:12.5px">@Formato.Pesos(p.Monto) · @Formato.FechaCorta(p.PeriodoCobro)</div>
                                        </div>
                                    </div>
                                    <p class="muted" style="font-size:13px; margin:0">¿Se cobró?</p>
                                    <div class="row" style="gap:8px">
                                        <button class="btn btn-secondary" style="flex:1" @onclick="() => Resolver(p, false)">No</button>
                                        <button class="btn btn-primary" style="flex:1" @onclick="() => Resolver(p, true)">Sí</button>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
            }

            @if (_menuAbierto)
            {
                <div class="card" style="margin-bottom: 14px;">
                    <div class="stack">
                        <div class="row-between">
                            <div>
                                <div style="font-weight:650">@NombreDe(context)</div>
                                <div class="muted">@EmailDe(context)</div>
                            </div>
                        </div>
                        <div class="divider"></div>
                        <button class="btn btn-secondary btn-block" @onclick="IrAPerfil">
                            <Icon Name="user" Size="17" /> Perfil
                        </button>
                        <button class="btn btn-secondary btn-block" @onclick="CerrarSesion">
                            <Icon Name="logout" Size="17" /> Cerrar sesión
                        </button>
                    </div>
                </div>
            }

            <div class="page-enter">
                @Body
            </div>
        </div>

        <nav class="tabbar @(UiOverlay.ModalPantallaCompletaAbierto ? "tabbar-hidden" : "")">
            <div class="tabbar-inner">
                <NavLink class="tab-link" href="/" Match="NavLinkMatch.All">
                    <span class="tab-icon"><Icon Name="wallet" Size="21" /></span>
                    <span>Día a día</span>
                </NavLink>
                <NavLink class="tab-link" href="/hogar">
                    <span class="tab-icon"><Icon Name="home" Size="21" /></span>
                    <span>Hogar</span>
                </NavLink>
                <NavLink class="tab-link" href="/subsidios">
                    <span class="tab-icon"><Icon Name="calculator" Size="21" /></span>
                    <span>Subsidios</span>
                </NavLink>
                <NavLink class="tab-link" href="/mas">
                    <span class="tab-icon"><Icon Name="archive" Size="21" /></span>
                    <span>Más</span>
                </NavLink>
                <AuthorizeView Roles="SuperAdmin" Context="adminContext">
                    <Authorized>
                        <NavLink class="tab-link" href="/admin">
                            <span class="tab-icon"><Icon Name="shield" Size="21" /></span>
                            <span>Admin</span>
                        </NavLink>
                    </Authorized>
                </AuthorizeView>
            </div>
        </nav>
    </Authorized>
    <NotAuthorized>
        <div class="page-enter">
            @Body
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private bool _menuAbierto;
    private bool _panelNotifAbierto;
    private bool _errorCargando;
    private List<ConfirmacionPendienteResponse> _pendientes = [];
    private readonly CancellationTokenSource _cts = new();

    private static readonly TimeSpan IntervaloRefresco = TimeSpan.FromMinutes(2);

    protected override async Task OnInitializedAsync()
    {
        ThemeService.OnChange += StateHasChanged;
        UiOverlay.OnChange += StateHasChanged;
        AuthProvider.AuthenticationStateChanged += OnAuthenticationChanged;
        await CargarPendientesAsync();
        _ = SondearPendientesPeriodicamenteAsync();
    }

    /// <summary>
    /// La campanita antes solo cargaba al iniciar sesión o al abrir el
    /// panel — si llegaba un push de "cobro próximo" con la app abierta, el
    /// número no cambiaba hasta recargar. Este sondeo la mantiene al día
    /// sin necesidad de que el usuario haga nada.
    /// </summary>
    private async Task SondearPendientesPeriodicamenteAsync()
    {
        using var timer = new PeriodicTimer(IntervaloRefresco);
        try
        {
            while (await timer.WaitForNextTickAsync(_cts.Token))
            {
                await CargarPendientesAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // El layout se destruyó (Dispose) — dejar de sondear, nada que limpiar.
        }
    }

    private async void OnAuthenticationChanged(Task<AuthenticationState> _)
    {
        await CargarPendientesAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task CargarPendientesAsync()
    {
        var resultado = await Api.ObtenerConfirmacionesPendientesAsync();
        if (resultado is null)
        {
            // Se deja _pendientes como estaba (el badge no desaparece de
            // golpe por un error pasajero) — solo se marca el error para
            // que el panel, si está abierto, ofrezca reintentar.
            _errorCargando = true;
            return;
        }

        _errorCargando = false;
        _pendientes = resultado;
    }

    private void ToggleMenu() => _menuAbierto = !_menuAbierto;

    private async Task ToggleNotificaciones()
    {
        _panelNotifAbierto = !_panelNotifAbierto;
        if (_panelNotifAbierto) await CargarPendientesAsync();
    }

    private async Task Resolver(ConfirmacionPendienteResponse pendiente, bool ocurrio)
    {
        await Api.ResolverConfirmacionAsync(pendiente.SuscripcionId, pendiente.Id, ocurrio);
        await CargarPendientesAsync();
    }

    private void IrAPerfil()
    {
        _menuAbierto = false;
        Nav.NavigateTo("/perfil");
    }

    private async Task CambiarTema(Tema tema)
    {
        var nuevo = ThemeService.Actual == tema ? Tema.Sistema : tema;
        await ThemeService.CambiarAsync(nuevo);
    }

    private static string NombreDe(AuthenticationState context) =>
        context.User.FindFirst("nombre")?.Value ?? "Tú";

    private static string EmailDe(AuthenticationState context) =>
        context.User.FindFirst("email")?.Value ?? "";

    private static string Inicial(AuthenticationState context)
    {
        var nombre = NombreDe(context);
        return nombre.Length > 0 ? nombre[..1].ToUpperInvariant() : "?";
    }

    private async Task CerrarSesion()
    {
        _menuAbierto = false;
        await AuthService.LogoutAsync();
        Nav.NavigateTo("/login", forceLoad: false);
    }

    public void Dispose()
    {
        ThemeService.OnChange -= StateHasChanged;
        UiOverlay.OnChange -= StateHasChanged;
        AuthProvider.AuthenticationStateChanged -= OnAuthenticationChanged;
        _cts.Cancel();
        _cts.Dispose();
    }
}
