@page "/perfil"
@attribute [Authorize]
@inject ApiClient Api
@inject AuthService AuthService
@inject NavigationManager Nav
@inject PushNotificationService Push
@inject IJSRuntime JS

<PageTitle>Perfil · MoneyBack</PageTitle>

<div class="stack">
    <div class="row">
        <button class="btn-ghost btn" @onclick='() => Nav.NavigateTo("/")'><Icon Name="chevron-left" Size="18" /> Inicio</button>
    </div>

    <h2>Tu perfil</h2>

    @if (_cargando)
    {
        <div class="center-screen"><div class="spinner spinner-accent"></div></div>
    }
    else
    {
        <div class="card">
            <div class="stack">
                <div class="label">Nombre</div>
                <EditForm Model="_nombreForm" OnValidSubmit="GuardarNombre">
                    <div class="stack">
                        <InputText class="input" @bind-Value="_nombreForm.Nombre" placeholder="Tu nombre" />
                        <AlertBox Mensaje="@_errorNombre" />
                        @if (_nombreGuardado)
                        {
                            <AlertBox Tipo="accent" Mensaje="Nombre actualizado." />
                        }
                        <button class="btn btn-primary" type="submit" disabled="@_guardandoNombre">
                            @if (_guardandoNombre) { <span class="spinner"></span> }
                            <span>Guardar</span>
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>

        <div class="card">
            <div class="stack">
                <div class="row" style="gap:8px">
                    <Icon Name="calendar" Size="17" />
                    <span class="label" style="margin:0">Días de pago aproximados</span>
                </div>
                <p class="muted" style="font-size:13px">
                    Úsalos para avisos como "te faltan pocos días para tu próximo
                    pago". No tienen que ser exactos — si a veces te pagan antes
                    o después, deja el día que más se acerque.
                </p>
                <EditForm Model="_diasPagoForm" OnValidSubmit="GuardarDiasPago">
                    <div class="row" style="gap:10px">
                        <div class="field" style="margin:0; flex:1">
                            <label>Primer pago</label>
                            <InputNumber class="input" @bind-Value="_diasPagoForm.DiaPago1" placeholder="1" />
                        </div>
                        <div class="field" style="margin:0; flex:1">
                            <label>Segundo pago (opcional)</label>
                            <InputNumber class="input" @bind-Value="_diasPagoForm.DiaPago2" placeholder="15" />
                        </div>
                    </div>
                    <AlertBox Mensaje="@_errorDiasPago" />
                    @if (_diasPagoGuardado)
                    {
                        <AlertBox Tipo="accent" Mensaje="Días de pago actualizados." />
                    }
                    <button class="btn btn-primary" type="submit" disabled="@_guardandoDiasPago" style="margin-top:10px">
                        @if (_guardandoDiasPago) { <span class="spinner"></span> }
                        <span>Guardar</span>
                    </button>
                </EditForm>
            </div>
        </div>

        <div class="card">
            <div class="stack">
                <div class="row" style="gap:8px">
                    <Icon Name="lock" Size="17" />
                    <span class="label" style="margin:0">Contraseña</span>
                </div>
                <EditForm Model="_passwordForm" OnValidSubmit="CambiarPassword">
                    <div class="stack">
                        <div class="field">
                            <label>Contraseña actual</label>
                            <InputText class="input" type="password" @bind-Value="_passwordForm.PasswordActual" />
                        </div>
                        <div class="field">
                            <label>Contraseña nueva</label>
                            <InputText class="input" type="password" @bind-Value="_passwordForm.PasswordNueva" placeholder="Mínimo 10 caracteres" />
                        </div>
                        <AlertBox Mensaje="@_errorPassword" />
                        @if (_passwordCambiada)
                        {
                            <AlertBox Tipo="accent" Mensaje="Contraseña actualizada." />
                        }
                        <button class="btn btn-primary" type="submit" disabled="@_guardandoPassword">
                            @if (_guardandoPassword) { <span class="spinner"></span> }
                            <span>Cambiar contraseña</span>
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>

        <div class="card">
            <div class="stack">
                <div class="row" style="gap:8px">
                    <Icon Name="bell" Size="17" />
                    <span class="label" style="margin:0">Notificaciones push</span>
                </div>
                @if (!_pushSoportado)
                {
                    <p class="muted" style="font-size:13px">Tu navegador no soporta notificaciones push.</p>
                }
                else
                {
                    <p class="muted" style="font-size:13px">
                        Te avisamos aquí cuando se acerque un cobro programado.
                        En iPhone, agrega MoneyBack a tu pantalla de inicio
                        (botón compartir → "Agregar a pantalla de inicio") para
                        poder recibirlas — Safari no las entrega a una pestaña normal.
                    </p>
                    <AlertBox Mensaje="@_errorPush" />
                    @if (_permisoDenegado)
                    {
                        <AlertBox Tipo="warning" Mensaje="Bloqueaste las notificaciones para este sitio. Actívalas desde los ajustes del navegador." />
                    }
                    else if (_pushActivo)
                    {
                        <button class="btn btn-secondary btn-block" disabled="@_procesandoPush" @onclick="DesactivarPush">
                            @if (_procesandoPush) { <span class="spinner"></span> }
                            <span>Desactivar notificaciones</span>
                        </button>
                    }
                    else
                    {
                        <button class="btn btn-primary btn-block" disabled="@_procesandoPush" @onclick="ActivarPush">
                            @if (_procesandoPush) { <span class="spinner"></span> }
                            <span>Activar notificaciones</span>
                        </button>
                    }
                }
            </div>
        </div>

        <div class="card">
            <div class="stack">
                <div class="row" style="gap:8px">
                    <Icon Name="archive" Size="17" />
                    <span class="label" style="margin:0">Atajo rápido (iOS)</span>
                </div>
                <p class="muted" style="font-size:13px">
                    Genera un token para conectar un Atajo del Botón de Acción
                    del iPhone directo con MoneyBack, sin pasar por la app.
                    Este token solo puede leer tus categorías y crear un
                    ingreso o gasto — no puede tocar metas, deudas ni nada
                    más de tu cuenta.
                </p>

                @if (_tokenNuevo is not null)
                {
                    <div class="alert alert-accent">
                        <div class="stack" style="gap:10px; width:100%">
                            <strong>Cópialo ahora — no se vuelve a mostrar:</strong>
                            <div class="row" style="gap:6px">
                                <input class="input" readonly value="@_tokenNuevo" style="font-family:monospace; font-size:12.5px" />
                                <button class="btn btn-secondary" type="button" @onclick="CopiarToken">Copiar</button>
                            </div>
                            <div class="divider"></div>

                            <p style="margin:0; font-size:13px">
                                Instala el que quieras y, en el atajo instalado, abre el primer paso
                                (<strong>Texto</strong>), borra <code style="font-size:11px">Pega_tu_token_Aquí</code>
                                y pega el de arriba. Eso es todo.
                            </p>

                            @if (!string.IsNullOrWhiteSpace(EnlaceAtajoGasto))
                            {
                                <div class="divider"></div>
                                <div style="font-weight:600">Gasto rápido</div>
                                <p class="muted" style="font-size:12.5px; margin:0">
                                    Lo disparas tú: escribes el monto y eliges la categoría de una lista.
                                    Va bien en el Botón de Acción (Ajustes → Botón de Acción → Atajo) o en
                                    el toque trasero (Ajustes → Accesibilidad → Tocar → Toque trasero).
                                </p>
                                <a class="btn btn-primary btn-block" href="@EnlaceAtajoGasto" target="_blank" rel="noopener">
                                    <Icon Name="archive" Size="17" /> Instalar
                                </a>
                            }

                            @if (!string.IsNullOrWhiteSpace(EnlaceAtajoBancos))
                            {
                                <div class="divider"></div>
                                <div style="font-weight:600">Registro automático del banco</div>
                                <p class="muted" style="font-size:12.5px; margin:0">
                                    Registra solo, sin que toques nada: lee el SMS de Davivienda y la
                                    notificación de Nu, y te avisa acá cuando lo guardó. Entra como
                                    <strong>Sin clasificar</strong> para que le pongas categoría después.
                                </p>
                                <a class="btn btn-primary btn-block" href="@EnlaceAtajoBancos" target="_blank" rel="noopener">
                                    <Icon Name="bell" Size="17" /> Instalar
                                </a>
                                <p class="muted" style="font-size:12px; margin:0">
                                    Trae los disparadores listos. Si tu banco es otro, cámbialos desde
                                    el mismo atajo.
                                </p>
                            }
                        </div>
                    </div>
                }

                <AlertBox Mensaje="@_errorToken" />

                @foreach (var t in _tokens)
                {
                    <div class="row-between">
                        <div>
                            <div style="font-weight:600">@(t.Nombre ?? "Token para Atajos")</div>
                            <div class="muted" style="font-size:12px">
                                Creado @Formato.FechaCorta(t.FechaCreacion)
                                @(t.UltimoUso is not null ? $"· última vez {Formato.FechaHora(t.UltimoUso.Value.ToLocalTime())}" : "· nunca usado")
                            </div>
                        </div>
                        <button class="icon-btn" style="width:30px;height:30px;background:transparent;border:none" @onclick="() => EliminarToken(t.Id)">
                            <Icon Name="trash" Size="15" />
                        </button>
                    </div>
                    <div class="divider"></div>
                }

                <div class="divider"></div>

                @* iOS no muestra historial de automatizaciones, así que esta
                   lista es la única evidencia de si el atajo llegó o no.
                   Sin ella, "no hizo nada" solo se puede adivinar. *@
                <div class="row-between">
                    <span class="label">Últimas llamadas del atajo</span>
                    <button class="btn btn-ghost" style="font-size:13px" @onclick="CargarLlamadas" disabled="@_cargandoLlamadas">
                        @if (_cargandoLlamadas) { <span class="spinner"></span> } else { <span>Actualizar</span> }
                    </button>
                </div>

                @if (_llamadas.Count == 0)
                {
                    <p class="muted" style="font-size:12.5px; margin:0">
                        Sin registros todavía. Si compraste algo y acá no aparece nada a esa hora,
                        la automatización no se disparó: el problema está en Atajos, no en el servidor.
                    </p>
                }
                else
                {
                    @foreach (var llamada in _llamadas)
                    {
                        <div class="row" style="gap:8px; align-items:flex-start; padding:5px 0">
                            <span style="font-size:13px">@(llamada.Exito ? "✅" : "⚠️")</span>
                            <div style="min-width:0; flex:1">
                                <div style="font-size:12.5px; font-weight:600">@Formato.FechaHora(llamada.Fecha.ToLocalTime())</div>
                                <div class="muted" style="font-size:12px">@llamada.Detalle</div>
                            </div>
                        </div>
                    }
                }

                <button class="btn btn-primary btn-block" disabled="@_generandoToken" @onclick="GenerarToken">
                    @if (_generandoToken) { <span class="spinner"></span> }
                    <span>Generar token nuevo</span>
                </button>
            </div>
        </div>

        <div class="card">
            <div class="stack">
                <div>
                    <div style="font-weight:600">Claves de recuperación</div>
                    <div class="muted" style="font-size:13px">
                        Si olvidas la contraseña, con una de estas vuelves a entrar sin depender de nadie.
                        Guárdalas donde puedas encontrarlas: una foto, tu gestor de contraseñas, un papel.
                    </div>
                </div>

                @if (_codigosNuevos is not null)
                {
                    <div class="card" style="border-left:3px solid var(--color-warning)">
                        <div class="stack" style="gap:6px">
                            <strong style="font-size:13.5px">Cópialas ahora</strong>
                            @* Solo se pueden ver en este momento: el servidor
                               guarda el hash, así que ni él puede volver a
                               mostrarlas. *@
                            <div style="font-family:ui-monospace,monospace; font-size:15px; line-height:1.9; letter-spacing:0.04em">
                                @foreach (var codigo in _codigosNuevos)
                                {
                                    <div>@codigo</div>
                                }
                            </div>
                            <button class="btn btn-secondary btn-block" @onclick="CopiarCodigos">Copiar todas</button>
                            <span class="muted" style="font-size:12px">
                                No las vas a poder volver a ver. Si las pierdes, genera una lista nueva.
                            </span>
                        </div>
                    </div>
                }
                else if (_codigosQuedan == 0)
                {
                    <AlertBox Tipo="warning" Mensaje="No tienes claves de recuperación. Si olvidas la contraseña, no vas a poder entrar." />
                }
                else
                {
                    <p class="muted" style="font-size:13px; margin:0">
                        Te quedan <strong>@_codigosQuedan</strong> claves sin usar.
                    </p>
                }

                <AlertBox Mensaje="@_errorCodigos" />

                <button class="btn @(_codigosQuedan == 0 ? "btn-primary" : "btn-secondary") btn-block"
                        disabled="@_generandoCodigos" @onclick="GenerarCodigos">
                    @if (_generandoCodigos) { <span class="spinner"></span> }
                    <span>@(_codigosQuedan == 0 ? "Generar claves de recuperación" : "Generar claves nuevas")</span>
                </button>
                @if (_codigosQuedan > 0)
                {
                    <span class="muted" style="font-size:12px">Generar nuevas invalida las anteriores.</span>
                }
            </div>
        </div>

        <div class="card">
            <div class="stack">
                <div>
                    <div style="font-weight:600">Invita a alguien a MoneyBack</div>
                    <div class="muted" style="font-size:13px">
                        Le mandas el enlace y se registra directo, sin pedirte ningún código.
                        Sirve una sola vez y vence en 7 días.
                    </div>
                </div>

                @if (_enlaceNuevo is not null)
                {
                    <div class="stack" style="gap:8px">
                        <div class="field" style="margin:0">
                            <label>Listo, cópialo y mándaselo</label>
                            <div class="row" style="gap:8px">
                                <input class="input" readonly value="@_enlaceNuevo" style="flex:1" />
                                <button class="btn btn-secondary" type="button" @onclick="() => Copiar(_enlaceNuevo!)">Copiar</button>
                            </div>
                        </div>
                        @* Solo se puede ver ahora: el servidor guarda el hash,
                           no el enlace, así que ni él puede volver a armarlo. *@
                        <span class="muted" style="font-size:12.5px">No lo vas a poder volver a ver. Si lo pierdes, genera otro.</span>
                    </div>
                }

                @if (_invitaciones.Count > 0)
                {
                    <div class="divider"></div>
                    @foreach (var inv in _invitaciones)
                    {
                        <div class="row-between" style="padding:6px 0">
                            <div>
                                <div style="font-weight:600; font-size:14px">
                                    @(inv.UsadaPorNombre ?? $"Creada el {inv.CreadoEn.ToLocalTime():d MMM}")
                                </div>
                                <div class="muted" style="font-size:12.5px">
                                    @(inv.Estado == "Pendiente" ? $"Vence el {inv.ExpiraEn.ToLocalTime():d MMM}" : inv.Estado)
                                </div>
                            </div>
                            @if (inv.Estado == "Pendiente")
                            {
                                <button class="btn btn-ghost" disabled="@(_anulando == inv.Id)" @onclick="() => Anular(inv.Id)">
                                    @if (_anulando == inv.Id) { <span class="spinner"></span> } else { <span class="muted" style="font-size:13px">Anular</span> }
                                </button>
                            }
                        </div>
                    }
                }

                <AlertBox Mensaje="@_errorInvitacion" />

                <button class="btn btn-secondary btn-block" disabled="@_generandoInvitacion" @onclick="GenerarInvitacion">
                    @if (_generandoInvitacion) { <span class="spinner"></span> } else { <Icon Name="plus" Size="17" /> }
                    <span>Generar enlace de invitación</span>
                </button>
            </div>
        </div>

        <div class="card">
            <div class="row-between">
                <span class="muted">Correo</span>
                <span>@_perfil?.Email</span>
            </div>
        </div>
    }
</div>

@code {
    private bool _cargando = true;
    private bool _guardandoNombre;
    private bool _guardandoPassword;
    private bool _nombreGuardado;
    private bool _passwordCambiada;
    private string? _errorNombre;
    private string? _errorPassword;
    private PerfilResponse? _perfil;
    private readonly NombreFormModel _nombreForm = new();
    private readonly PasswordFormModel _passwordForm = new();
    private readonly DiasPagoFormModel _diasPagoForm = new();
    private bool _guardandoDiasPago;
    private bool _diasPagoGuardado;
    private string? _errorDiasPago;

    private bool _pushSoportado;
    private bool _pushActivo;
    private bool _permisoDenegado;
    private bool _procesandoPush;
    private string? _errorPush;

    // Se muestran en campos de solo lectura con botón de copiar: escribir una
    // URL larga a mano en la app Atajos es la forma más fácil de que el atajo
    // "no funcione" por un typo invisible.

    /// <summary>
    /// Enlace de iCloud a la plantilla del atajo. Es la única forma que deja
    /// Apple de repartir un atajo ya armado (los archivos .shortcut sin firmar
    /// los rechaza iOS), y solo se puede generar desde un iPhone.
    ///
    /// La plantilla NO puede traer un token real: el token queda escrito
    /// dentro del atajo y cualquiera que instale el enlace registraría
    /// movimientos en la cuenta de quien lo compartió. Debe traer el texto
    /// PEGA_TU_TOKEN_AQUI, que cada persona reemplaza por el suyo.
    ///
    /// Vacío = la app muestra solo la receta manual, sin botón de instalar.
    ///
    /// Esta plantilla se verificó descargándola: no trae ningún token real,
    /// el primer paso dice "Pega_tu_token_Aquí", y los encabezados quedan
    /// bien cableados (X-Atajo-Token y X-Categoria al paso correcto). Si
    /// algún día se reemplaza por otra, hay que revisar lo mismo antes.
    /// </summary>
    private const string EnlaceAtajoGasto = "https://www.icloud.com/shortcuts/e279acdb7e564c06a5fe7dbe7f42c606";

    /// <summary>
    /// Plantilla del atajo que registra solo desde el banco: trae los dos
    /// disparadores (SMS de Davivienda y notificación de Nu) ya configurados.
    /// Igual que el otro, no puede llevar un token real — un enlace de iCloud
    /// guarda el atajo completo y quien lo instale escribiría en esa cuenta.
    /// Vacío = no se muestra el botón.
    ///
    /// Verificada descargándola: sin token real, los dos disparadores viajan
    /// dentro del enlace y los encabezados apuntan a donde deben.
    /// </summary>
    private const string EnlaceAtajoBancos = "https://www.icloud.com/shortcuts/744cf37baa914e91a860446c41563103";


    private List<string>? _codigosNuevos;
    private int _codigosQuedan;
    private bool _generandoCodigos;
    private string? _errorCodigos;

    private List<LlamadaAtajoResponse> _llamadas = [];
    private bool _cargandoLlamadas;

    private List<InvitacionAppResponse> _invitaciones = [];
    private string? _enlaceNuevo;
    private bool _generandoInvitacion;
    private int? _anulando;
    private string? _errorInvitacion;

    private List<TokenAtajoResponse> _tokens = [];
    private string? _tokenNuevo;
    private bool _generandoToken;
    private string? _errorToken;

    protected override async Task OnInitializedAsync()
    {
        _perfil = await Api.ObtenerPerfilAsync();
        if (_perfil is not null)
        {
            _nombreForm.Nombre = _perfil.Nombre;
            _diasPagoForm.DiaPago1 = _perfil.DiaPago1;
            _diasPagoForm.DiaPago2 = _perfil.DiaPago2;
        }
        _cargando = false;

        _pushSoportado = await Push.SonSoportadasAsync();
        if (_pushSoportado)
        {
            _pushActivo = await Push.EstaSuscritoAsync();
            _permisoDenegado = await Push.ObtenerEstadoPermisoAsync() == "denied";
        }

        var tokens = Api.ObtenerTokensAtajoAsync();
        var invitaciones = Api.ObtenerInvitacionesAppAsync();
        var llamadas = Api.ObtenerLlamadasAtajoAsync();
        var codigos = AuthService.CodigosRecuperacionRestantesAsync();
        await Task.WhenAll(tokens, invitaciones, llamadas, codigos);
        _tokens = tokens.Result;
        _invitaciones = invitaciones.Result;
        _llamadas = llamadas.Result;
        _codigosQuedan = codigos.Result;
    }

    private async Task GenerarToken()
    {
        _errorToken = null;
        _tokenNuevo = null;
        _generandoToken = true;

        var resultado = await Api.CrearTokenAtajoAsync(new CrearTokenAtajoRequest(null));
        if (resultado.Exito)
        {
            _tokenNuevo = resultado.Valor!.Token;
            _tokens = await Api.ObtenerTokensAtajoAsync();
        }
        else
        {
            _errorToken = resultado.TodosLosErrores();
        }

        _generandoToken = false;
    }

    private async Task EliminarToken(int id)
    {
        await Api.EliminarTokenAtajoAsync(id);
        _tokens = await Api.ObtenerTokensAtajoAsync();
    }

    private async Task CopiarToken()
    {
        if (_tokenNuevo is null) return;
        await Copiar(_tokenNuevo);
    }

    private async Task GenerarCodigos()
    {
        _errorCodigos = null;
        _generandoCodigos = true;

        var resultado = await AuthService.GenerarCodigosRecuperacionAsync();

        if (resultado.Exito)
        {
            _codigosNuevos = resultado.Valor!.Codigos;
            _codigosQuedan = _codigosNuevos.Count;
        }
        else
        {
            _errorCodigos = resultado.TodosLosErrores();
        }

        _generandoCodigos = false;
    }

    private async Task CopiarCodigos()
    {
        if (_codigosNuevos is null) return;
        await Copiar(string.Join("\n", _codigosNuevos));
    }

    private async Task CargarLlamadas()
    {
        _cargandoLlamadas = true;
        _llamadas = await Api.ObtenerLlamadasAtajoAsync();
        _cargandoLlamadas = false;
    }

    private async Task GenerarInvitacion()
    {
        _errorInvitacion = null;
        _generandoInvitacion = true;

        var resultado = await Api.CrearInvitacionAppAsync();

        if (resultado.Exito)
        {
            // El enlace se arma acá y no en el servidor: el API no sabe en qué
            // dominio está montada la app, y adivinarlo produciría enlaces que
            // no abren.
            _enlaceNuevo = $"{Nav.BaseUri}register?invitacion={resultado.Valor!.Token}";
            _invitaciones = await Api.ObtenerInvitacionesAppAsync();
        }
        else
        {
            _errorInvitacion = resultado.TodosLosErrores();
        }

        _generandoInvitacion = false;
    }

    private async Task Anular(int id)
    {
        _errorInvitacion = null;
        _anulando = id;

        if (await Api.AnularInvitacionAppAsync(id))
        {
            _invitaciones = await Api.ObtenerInvitacionesAppAsync();
            _enlaceNuevo = null;
        }

        _anulando = null;
    }

    private async Task Copiar(string texto)
    {
        var modulo = await JS.InvokeAsync<IJSObjectReference>("import", "./js/interop.js");
        await modulo.InvokeVoidAsync("copiarAlPortapapeles", texto);
    }

    private async Task ActivarPush()
    {
        _errorPush = null;
        _procesandoPush = true;

        var ok = await Push.ActivarAsync();
        _pushActivo = ok && await Push.EstaSuscritoAsync();
        _permisoDenegado = await Push.ObtenerEstadoPermisoAsync() == "denied";
        if (!ok) _errorPush = "No se pudo activar. Verifica los permisos de notificaciones del navegador.";

        _procesandoPush = false;
    }

    private async Task DesactivarPush()
    {
        _procesandoPush = true;
        await Push.DesactivarAsync();
        _pushActivo = await Push.EstaSuscritoAsync();
        _procesandoPush = false;
    }

    private async Task GuardarNombre()
    {
        _errorNombre = null;
        _nombreGuardado = false;
        _guardandoNombre = true;

        var resultado = await Api.ActualizarPerfilAsync(new ActualizarPerfilRequest(_nombreForm.Nombre));

        if (resultado.Exito)
        {
            _perfil = resultado.Valor;
            _nombreGuardado = true;
            await AuthService.RefrescarClaimsAsync();
        }
        else
        {
            _errorNombre = resultado.TodosLosErrores();
        }

        _guardandoNombre = false;
    }

    private async Task CambiarPassword()
    {
        _errorPassword = null;
        _passwordCambiada = false;
        _guardandoPassword = true;

        var resultado = await Api.CambiarPasswordAsync(new CambiarPasswordRequest(_passwordForm.PasswordActual, _passwordForm.PasswordNueva));

        if (resultado.Exito)
        {
            _passwordCambiada = true;
            _passwordForm.PasswordActual = "";
            _passwordForm.PasswordNueva = "";
        }
        else
        {
            _errorPassword = resultado.TodosLosErrores();
        }

        _guardandoPassword = false;
    }

    private async Task GuardarDiasPago()
    {
        _errorDiasPago = null;
        _diasPagoGuardado = false;
        _guardandoDiasPago = true;

        var resultado = await Api.ActualizarDiasPagoAsync(new ActualizarDiasPagoRequest(_diasPagoForm.DiaPago1, _diasPagoForm.DiaPago2));

        if (resultado.Exito)
        {
            _perfil = resultado.Valor;
            _diasPagoGuardado = true;
        }
        else
        {
            _errorDiasPago = resultado.TodosLosErrores();
        }

        _guardandoDiasPago = false;
    }

