@page "/categorias"
@attribute [Authorize]
@inject ApiClient Api
@inject NavigationManager Nav

<PageTitle>Categorías · MoneyBack</PageTitle>

<div class="stack">
    <div class="row">
        <button class="btn-ghost btn" @onclick='() => Nav.NavigateTo("/mas")'><Icon Name="chevron-left" Size="18" /> Más</button>
    </div>

    <h2>Categorías</h2>

    @if (_cargando)
    {
        <div class="center-screen"><div class="spinner spinner-accent"></div></div>
    }
    else
    {
        <div class="card">
            @if (!_mostrarForm)
            {
                <div class="stack">
                    <button class="btn btn-primary btn-block" @onclick="() => _mostrarForm = true">
                        <Icon Name="plus" Size="18" /> Nueva categoría
                    </button>
                    <button class="btn btn-secondary btn-block" @onclick="SembrarBasicas" disabled="@_sembrando">
                        @if (_sembrando) { <span class="spinner"></span> } else { <Icon Name="archive" Size="17" /> }
                        <span>Agregar categorías básicas</span>
                    </button>
                    @if (_mensajeSiembra is not null)
                    {
                        <AlertBox Tipo="accent" Mensaje="@_mensajeSiembra" />
                    }
                </div>
            }
            else
            {
                <EditForm Model="_form" OnValidSubmit="Crear">
                    <div class="stack">
                        <div class="segmented">
                            <button type="button" class="segmented-btn @(_form.Tipo == TipoCategoria.Gasto ? "active" : "")" @onclick="() => _form.Tipo = TipoCategoria.Gasto">Gasto</button>
                            <button type="button" class="segmented-btn @(_form.Tipo == TipoCategoria.Ingreso ? "active" : "")" @onclick="() => _form.Tipo = TipoCategoria.Ingreso">Ingreso</button>
                        </div>

                        <div class="field">
                            <label>Ícono</label>
                            <SelectorEmoji @bind-Valor="_form.Icono" Sugeridos="EmojisDeCategoria" />
                        </div>

                        <div class="field">
                            <label>Nombre</label>
                            <InputText class="input" @bind-Value="_form.Nombre" placeholder="Mascotas" />
                        </div>
                        <AlertBox Mensaje="@_error" />
                        <div class="row">
                            <button class="btn btn-secondary" type="button" @onclick="() => _mostrarForm = false">Cancelar</button>
                            <button class="btn btn-primary" style="flex:1" type="submit" disabled="@_guardando">
                                @if (_guardando) { <span class="spinner"></span> }
                                <span>Crear</span>
                            </button>
                        </div>
                    </div>
                </EditForm>
            }
        </div>

        <div class="card">
            <div class="stack">
                <div class="label">Gastos</div>
                @foreach (var cat in _categorias.Where(c => c.Tipo == TipoCategoria.Gasto))
                {
                    @RenderCategoria(cat)
                }
            </div>
        </div>

        <div class="card">
            <div class="stack">
                <div class="label">Ingresos</div>
                @foreach (var cat in _categorias.Where(c => c.Tipo == TipoCategoria.Ingreso))
                {
                    @RenderCategoria(cat)
                }
            </div>
        </div>
    }

    @if (_comercios.Count > 0)
    {
        <div class="card">
            <div class="stack">
                <div class="label">Sitios que la app ya reconoce</div>
                <p class="muted" style="font-size:13px; margin:0">
                    Cada vez que corriges la categoría de un gasto que llegó de tu banco,
                    la app guarda dónde va ese sitio y no vuelve a preguntar. Si alguno
                    quedó mal, olvídalo y te preguntará de nuevo la próxima compra.
                </p>
                @foreach (var c in _comercios)
                {
                    <div class="row-between" style="padding:8px 0">
                        <div class="row" style="gap:10px; min-width:0">
                            <span style="font-size:18px">@c.CategoriaIcono</span>
                            <div style="min-width:0">
                                <div style="font-weight:600; overflow:hidden; text-overflow:ellipsis; white-space:nowrap">
                                    @c.Comercio
                                </div>
                                <div class="muted" style="font-size:12.5px">entra como @c.CategoriaNombre</div>
                            </div>
                        </div>
                        <button class="btn btn-ghost" disabled="@(_olvidando == c.Id)" @onclick="() => Olvidar(c)">
                            @if (_olvidando == c.Id) { <span class="spinner"></span> } else { <Icon Name="trash" Size="16" /> }
                        </button>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    private static readonly string[] EmojisDeCategoria =
    [
        "🛒", "🍔", "🚗", "🏠", "💡", "🎬", "🏥", "👕", "📦",
        "💼", "🎁", "💰", "✈️", "🐾", "📚", "🎮", "☕", "💳"
    ];

    private bool _cargando = true;
    private bool _guardando;
    private bool _sembrando;
    private bool _mostrarForm;
    private string? _error;
    private string? _mensajeSiembra;
    private List<CategoriaResponse> _categorias = [];
    private List<ComercioAprendidoResponse> _comercios = [];
    private int? _olvidando;
    private readonly FormModel _form = new();

    protected override async Task OnInitializedAsync()
    {
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        _cargando = true;
        var categorias = Api.ObtenerCategoriasAsync();
        var comercios = Api.ObtenerComerciosAprendidosAsync();
        await Task.WhenAll(categorias, comercios);
        _categorias = categorias.Result;
        _comercios = comercios.Result;
        _cargando = false;
    }

    /// <summary>
    /// Olvidar borra solo la regla, no los gastos que ya entraron con esa
    /// categoría. Reescribirle el historial a alguien que solo pidió que la
    /// app dejara de suponer sería pasarse de listo.
    /// </summary>
    private async Task Olvidar(ComercioAprendidoResponse comercio)
    {
        _olvidando = comercio.Id;
        if (await Api.OlvidarComercioAprendidoAsync(comercio.Id)) _comercios.Remove(comercio);
        _olvidando = null;
    }

    private async Task Crear()
    {
        _error = null;
        _guardando = true;

        var resultado = await Api.CrearCategoriaAsync(new CrearCategoriaRequest(_form.Nombre, _form.Tipo, _form.Icono));

        if (resultado.Exito)
        {
            _mostrarForm = false;
            _form.Nombre = "";
            _form.Icono = "📦";
            await CargarAsync();
        }
        else
        {
            _error = resultado.TodosLosErrores();
        }

        _guardando = false;
    }

    private async Task SembrarBasicas()
    {
        _sembrando = true;
        _mensajeSiembra = null;
        var agregadas = await Api.SembrarCategoriasBasicasAsync();
        _mensajeSiembra = agregadas > 0
            ? $"Se agregaron {agregadas} categoría(s) nueva(s)."
            : "Ya tenías todas las categorías básicas.";
        await CargarAsync();
        _sembrando = false;
    }

    private async Task AlternarActiva(CategoriaResponse categoria)
    {
        await Api.ActualizarCategoriaAsync(categoria.Id, new ActualizarCategoriaRequest(categoria.Nombre, categoria.Icono, !categoria.Activa));
        await CargarAsync();
    }

    private RenderFragment RenderCategoria(CategoriaResponse cat) => @<div class="list-item">
        <div class="row">
            <div class="icon-bubble" style="background:var(--color-surface-2); font-size:18px">@cat.Icono</div>
            <span style="@(cat.Activa ? "" : "opacity:0.4")">@cat.Nombre</span>
        </div>
        <button class="btn btn-secondary" @onclick="() => AlternarActiva(cat)">
            <Icon Name="archive" Size="15" /> @(cat.Activa ? "Archivar" : "Reactivar")
        </button>
    </div>;

    private class FormModel
    {
        public string Nombre { get; set; } = "";
        public string Icono { get; set; } = "📦";
        public TipoCategoria Tipo { get; set; } = TipoCategoria.Gasto;
    }
}
