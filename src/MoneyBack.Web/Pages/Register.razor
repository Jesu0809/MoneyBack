@page "/registro"
@inject AuthService AuthService
@inject NavigationManager Nav

<PageTitle>Crear cuenta · MoneyBack</PageTitle>

<div class="auth-screen page-enter">
    <div class="auth-blob auth-blob-1"></div>
    <div class="auth-blob auth-blob-2"></div>

    <div class="auth-content">
        <div class="auth-logo">
            <Icon Name="wallet" Size="32" />
        </div>
        <div style="text-align:center">
            <h1 style="font-size:26px">MoneyBack</h1>
            <p class="muted">Crea tu cuenta para empezar a ahorrar.</p>
        </div>

        <div class="card" style="width:100%">
            <EditForm Model="_form" OnValidSubmit="Registrar">
                <div class="stack">
                    <div class="field">
                        <label>Tu nombre</label>
                        <InputText class="input" @bind-Value="_form.Nombre" placeholder="Jesus" />
                    </div>
                    <div class="field">
                        <label>Correo</label>
                        <InputText class="input" @bind-Value="_form.Email" placeholder="tucorreo@ejemplo.com" />
                    </div>
                    <div class="field">
                        <label>Contraseña</label>
                        <InputText class="input" type="password" @bind-Value="_form.Password" placeholder="Mínimo 10 caracteres" />
                    </div>
                    <div class="field">
                        <label>Código de invitación</label>
                        <InputText class="input" @bind-Value="_form.CodigoInvitacion" placeholder="El que te compartieron" />
                    </div>

                    <AlertBox Mensaje="@_error" />

                    <button class="btn btn-primary btn-block" type="submit" disabled="@_cargando">
                        @if (_cargando) { <span class="spinner"></span> }
                        <span>Crear cuenta</span>
                    </button>
                </div>
            </EditForm>
        </div>

        <p class="muted" style="text-align:center">
            ¿Ya tienes cuenta? <a href="/login">Inicia sesión</a>
        </p>
    </div>
</div>

@code {
    private readonly FormModel _form = new();
    private bool _cargando;
    private string? _error;

    private async Task Registrar()
    {
        _error = null;
        _cargando = true;

        var resultado = await AuthService.RegistrarAsync(new RegistrarUsuarioRequest(
            _form.Nombre, _form.Email, _form.Password, _form.CodigoInvitacion));

        if (resultado.Exito)
        {
            Nav.NavigateTo("/", forceLoad: false);
        }
        else
        {
            _error = resultado.TodosLosErrores();
        }

        _cargando = false;
    }

    private class FormModel
    {
        public string Nombre { get; set; } = "";
        public string Email { get; set; } = "";
        public string Password { get; set; } = "";
        public string CodigoInvitacion { get; set; } = "";
    }
}
