@page "/registro"
@* Los enlaces de invitación se generaron un tiempo apuntando a /register,
   que no era una ruta, y quien los recibía caía en "Not Found". Se arregló
   el generador, pero los que ya salieron por WhatsApp no se pueden
   corregir: esta segunda ruta es para que esos sigan sirviendo. *@
@page "/register"
@inject AuthService AuthService
@inject NavigationManager Nav

<PageTitle>Crear cuenta · MoneyBack</PageTitle>

<div class="auth-screen page-enter">
    <div class="auth-blob auth-blob-1"></div>
    <div class="auth-blob auth-blob-2"></div>

    <div class="auth-content">
        <div class="auth-logo">
            <Icon Name="wallet" Size="32" />
        </div>
        <div style="text-align:center">
            <h1 style="font-size:26px">MoneyBack</h1>
            <p class="muted">Crea tu cuenta para empezar a ahorrar.</p>
        </div>

        <div class="card" style="width:100%">
            <EditForm Model="_form" OnValidSubmit="Registrar">
                <div class="stack">
                    <div class="field">
                        <label>Tu nombre</label>
                        <InputText class="input" @bind-Value="_form.Nombre" placeholder="Tu nombre" />
                    </div>
                    <div class="field">
                        <label>Correo</label>
                        <InputText class="input" @bind-Value="_form.Email" placeholder="tucorreo@ejemplo.com" />
                    </div>
                    <div class="field">
                        <label>Contraseña</label>
                        <InputText class="input" type="password" @bind-Value="_form.Password" placeholder="Mínimo 10 caracteres" />
                    </div>
                    @if (_vinoPorEnlace)
                    {
                        @* Ya trae la invitación en el enlace. Mostrar un campo
                           lleno de un código que la persona no escribió solo
                           invita a que lo borre o lo dañe. *@
                        <div class="row" style="gap:8px">
                            <Icon Name="check" Size="16" />
                            <span class="muted" style="font-size:13.5px">Vienes con una invitación válida</span>
                        </div>
                    }
                    else
                    {
                        <div class="field">
                            <label>Código de invitación</label>
                            <InputText class="input" @bind-Value="_form.CodigoInvitacion" placeholder="El que te compartieron" />
                        </div>
                    }

                    <AlertBox Mensaje="@_error" />

                    <button class="btn btn-primary btn-block" type="submit" disabled="@_cargando">
                        @if (_cargando) { <span class="spinner"></span> }
                        <span>Crear cuenta</span>
                    </button>
                </div>
            </EditForm>
        </div>

        <p class="muted" style="text-align:center">
            ¿Ya tienes cuenta? <a href="/login">Inicia sesión</a>
        </p>
    </div>
</div>

@code {
    /// <summary>
    /// El enlace que reparte la app trae la invitación acá. Que venga en la
    /// URL y no haya que copiarla aparte es lo que convierte invitar a alguien
    /// en mandar un mensaje, en vez de una conversación de tres pasos.
    /// </summary>
    [SupplyParameterFromQuery(Name = "invitacion")]
    public string? InvitacionDelEnlace { get; set; }

    private bool _vinoPorEnlace;

    protected override void OnParametersSet()
    {
        if (string.IsNullOrWhiteSpace(InvitacionDelEnlace)) return;

        _form.CodigoInvitacion = InvitacionDelEnlace;
        _vinoPorEnlace = true;
    }

    private readonly FormModel _form = new();
    private bool _cargando;
    private string? _error;

    private async Task Registrar()
    {
        _error = null;
        _cargando = true;

        var resultado = await AuthService.RegistrarAsync(new RegistrarUsuarioRequest(
            _form.Nombre, _form.Email, _form.Password, _form.CodigoInvitacion));

        if (resultado.Exito)
        {
            // A poner sus topes, no al inicio. Es el único momento en que
            // alguien está dispuesto a contestar preguntas sobre su plata, y
            // sin topes los avisos —lo único que habla cuando el atajo
            // registra solo— nunca suenan.
            Nav.NavigateTo("/bienvenida", forceLoad: false);
        }
        else
        {
            _error = resultado.TodosLosErrores();
        }

        _cargando = false;
    }

    private class FormModel
    {
        public string Nombre { get; set; } = "";
        public string Email { get; set; } = "";
        public string Password { get; set; } = "";
        public string CodigoInvitacion { get; set; } = "";
    }
}
