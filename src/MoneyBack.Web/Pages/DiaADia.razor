@page "/"
@attribute [Authorize]
@using Microsoft.AspNetCore.WebUtilities
@inject ApiClient Api
@inject IJSRuntime JS
@inject AlmacenLocal Almacen
@inject ColaPendientes Cola
@inject UiOverlayService UiOverlay
@inject ConfirmacionService Confirmacion
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Día a día · MoneyBack</PageTitle>

<div class="stack">
    <div class="hero-balance">
        <div class="stack" style="gap:10px">
            <span class="label">Saldo acumulado</span>
            <AnimatedMoney Valor="_saldoAcumulado?.Balance ?? 0" Class="money money-lg" />
            <div class="divider"></div>
            <div class="row-between">
                <span class="muted">Ingresos totales</span>
                <span style="font-weight:650">@Formato.Pesos(_saldoAcumulado?.TotalIngresos ?? 0)</span>
            </div>
            <div class="row-between">
                <span class="muted">Gastos totales</span>
                <span style="font-weight:650">@Formato.Pesos(_saldoAcumulado?.TotalGastos ?? 0)</span>
            </div>
            @* El botón cambia según lo que haya, porque "nuestra meta" no
               significa lo mismo con cero, una o cinco. Con una favorita
               elegida va directo y la nombra: aportar es un gesto de dos
               segundos y preguntar cada vez lo convierte en una decisión. *@
            <button class="btn btn-secondary btn-block" @onclick="AportarAMeta">
                <Icon Name="coin" Size="16" /> @TextoDelBotonDeAporte()
            </button>
            @* Rescate cuando el atajo no alcanzó a registrar. Va acá y no
               escondido en Más porque el momento en que hace falta es justo
               cuando uno mira el saldo y no le cuadra. *@
            <button class="btn btn-ghost btn-block" @onclick="AbrirPegarSms">
                <Icon Name="credit-card" Size="16" /> Pegar SMS del banco
            </button>
        </div>
    </div>

    @if (_sinConexion)
    {
        <div class="card" style="border-left:3px solid var(--color-warning)">
            <div class="stack" style="gap:6px">
                <div class="row" style="gap:8px">
                    <Icon Name="alert-triangle" Size="17" />
                    <strong>Sin conexión</strong>
                </div>
                <span class="muted" style="font-size:13px">
                    @if (_guardadoEl is not null)
                    {
                        @($"Estos son los datos de {Formato.FechaHora(_guardadoEl.Value)}. Puede que falte algo reciente.")
                    }
                    else
                    {
                        @("No pudimos traer tus datos y no hay nada guardado en este teléfono todavía.")
                    }
                </span>
                @if (_pendientes.Count > 0)
                {
                    <span style="font-size:13px">
                        @_pendientes.Count @(_pendientes.Count == 1 ? "gasto anotado" : "gastos anotados") esperando subir.
                        Se suben solos cuando vuelva la señal.
                    </span>
                }
            </div>
        </div>
    }

    @if (_pendientes.Count > 0)
    {
        <div class="card">
            <div class="stack">
                <div class="label">Esperando subir</div>
                @foreach (var p in _pendientes)
                {
                    <div class="row-between" style="padding:6px 0">
                        <div class="row" style="gap:10px">
                            <span style="font-size:18px">@p.CategoriaIcono</span>
                            <div>
                                <div style="font-weight:600; font-size:14px">@p.CategoriaNombre</div>
                                <div class="muted" style="font-size:12px">
                                    @Formato.FechaHora(p.Fecha.ToLocalTime()) · @(string.IsNullOrEmpty(p.Nota) ? "sin nota" : p.Nota)
                                </div>
                            </div>
                        </div>
                        <span class="money" style="font-size:15px; color:var(--color-text-muted)">
                            @Formato.Pesos(p.Monto)
                        </span>
                    </div>
                }
                <button class="btn btn-secondary btn-block" disabled="@_subiendo" @onclick="ReintentarSubida">
                    @if (_subiendo) { <span class="spinner"></span> }
                    <span>Intentar subirlos ahora</span>
                </button>
            </div>
        </div>
    }

    @if (_avisoAprendizaje is not null)
    {
        <div class="card" style="border-left:3px solid var(--color-success)">
            <div class="row" style="gap:8px">
                <Icon Name="check" Size="17" />
                <span style="font-size:13.5px">@_avisoAprendizaje</span>
            </div>
        </div>
    }

    @{ var sinClasificar = _movimientos.Where(m => m.CategoriaNombre == CategoriaSinClasificar).ToList(); }
    @if (sinClasificar.Count > 0)
    {
        <div class="card" style="border-left:3px solid var(--color-warning)">
            <div class="stack">
                <div class="row" style="gap:8px">
                    <Icon Name="alert-triangle" Size="17" />
                    <strong>@sinClasificar.Count @(sinClasificar.Count == 1 ? "gasto sin clasificar" : "gastos sin clasificar")</strong>
                </div>
                <p class="muted" style="font-size:13px; margin:0">
                    Entraron solos desde tu banco. Esto es lo que el banco informó de cada uno —
                    dónde y cuándo fue — para que puedas reconocerlos. Mientras no tengan categoría,
                    tus reportes quedan incompletos.
                </p>
                @foreach (var m in sinClasificar)
                {
                    @if (_editandoId == m.Id)
                    {
                        <EditorMovimiento Form="_editForm" Categorias="_categorias.Where(c => c.Activa).ToList()"
                                          Guardando="_guardandoEdicion" Error="@_errorEdicion"
                                          OnGuardar="GuardarEdicion" OnCancelar="CancelarEdicion" />
                    }
                    else
                    {
                        <div class="row-between card-tap" style="padding:10px 0" @onclick="() => AbrirEdicion(m)">
                            <div class="row" style="gap:10px">
                                <div class="icon-bubble" style="background:var(--color-warning-soft)">
                                    <Icon Name="alert-triangle" Size="15" />
                                </div>
                                <div>
                                    <div style="font-weight:600">
                                        @(m.Comercio ?? m.Nota ?? "El banco no dijo dónde")
                                    </div>
                                    <div class="muted" style="font-size:12.5px">
                                        @Formato.FechaHora(m.Fecha) · toca para clasificar
                                    </div>
                                </div>
                            </div>
                            <span class="money" style="font-size:15px; color:var(--color-danger)">
                                @Formato.Pesos(m.Monto)
                            </span>
                        </div>
                    }
                }
                <span class="muted" style="font-size:12px">Toca uno para decirle a qué categoría pertenece.</span>
            </div>
        </div>
    }

    <div class="segmented" style="width:200px; margin: 0 auto">
        <button type="button" class="segmented-btn @(_vista == VistaResumen.Mes ? "active" : "")" @onclick="() => CambiarVista(VistaResumen.Mes)">Mes</button>
        <button type="button" class="segmented-btn @(_vista == VistaResumen.Anio ? "active" : "")" @onclick="() => CambiarVista(VistaResumen.Anio)">Año</button>
    </div>

    @if (_vista == VistaResumen.Mes)
    {
        <div class="row-between">
            <button class="icon-btn glass" @onclick="MesAnterior"><Icon Name="chevron-left" /></button>
            <strong>@NombreMes(_mesActual)</strong>
            <button class="icon-btn glass" @onclick="MesSiguiente"><Icon Name="chevron-right" /></button>
        </div>
    }
    else
    {
        <div class="row-between">
            <button class="icon-btn glass" @onclick="() => CambiarAnio(-1)"><Icon Name="chevron-left" /></button>
            <strong>@_anioActual</strong>
            <button class="icon-btn glass" @onclick="() => CambiarAnio(1)"><Icon Name="chevron-right" /></button>
        </div>
    }

    @if (_cargando)
    {
        <Esqueleto Filas="4" />
    }
    else
    {
        <div class="card">
            <div class="row" style="justify-content: space-around; text-align:center">
                <div class="stack" style="gap:4px; align-items:center">
                    <div class="icon-bubble icon-bubble-accent"><Icon Name="arrow-up" Size="16" /></div>
                    <span class="muted" style="font-size:12.5px">Ingresos</span>
                    <span style="font-weight:700; color: var(--color-accent-strong)">@Formato.Pesos(_resumen?.TotalIngresos ?? 0)</span>
                </div>
                <div class="stack" style="gap:4px; align-items:center">
                    <div class="icon-bubble icon-bubble-danger"><Icon Name="arrow-down" Size="16" /></div>
                    <span class="muted" style="font-size:12.5px">Gastos</span>
                    <span style="font-weight:700; color: var(--color-danger)">@Formato.Pesos(_resumen?.TotalGastos ?? 0)</span>
                </div>
                <div class="stack" style="gap:4px; align-items:center">
                    <div class="icon-bubble" style="background:var(--color-surface-2)"><Icon Name="wallet" Size="16" /></div>
                    <span class="muted" style="font-size:12.5px">Balance</span>
                    <span style="font-weight:700">@Formato.Pesos(_resumen?.Balance ?? 0)</span>
                </div>
            </div>
        </div>

        @if (_resumen is { GastosPorCategoria.Count: > 0 })
        {
            <div class="card">
                <div class="stack">
                    <div class="label">Gastos por categoría</div>
                    <div class="donut" style="background: @DonutGradient()">
                        <div class="donut-center">
                            <div class="muted" style="font-size:11.5px">Total</div>
                            <div class="money">@Formato.Pesos(_resumen.TotalGastos)</div>
                        </div>
                    </div>
                    @for (var i = 0; i < _resumen.GastosPorCategoria.Count; i++)
                    {
                        var cat = _resumen.GastosPorCategoria[i];
                        var pct = _resumen.TotalGastos > 0 ? cat.Total / _resumen.TotalGastos * 100 : 0;
                        <div class="row-between">
                            <div class="row" style="gap:8px">
                                <div class="category-dot" style="background: @Paleta[i % Paleta.Length]"></div>
                                <span>@cat.CategoriaIcono @cat.CategoriaNombre</span>
                            </div>
                            <div class="row" style="gap:8px">
                                <span class="muted" style="font-size:12.5px">@Formato.Porcentaje(pct)</span>
                                <span class="money" style="font-size:14.5px">@Formato.Pesos(cat.Total)</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        @if (_vista == VistaResumen.Anio)
        {
            <div class="empty-state">
                <p>Este es el resumen del año completo. Para ver el detalle día por día, cambia a "Mes", o entra a <a href="/reportes">Reportes</a> para más detalle y descargas.</p>
            </div>
        }
        else
        {
        <div class="stack">
            @{ var grupos = _movimientos.GroupBy(m => m.Fecha.ToLocalTime().Date).OrderByDescending(g => g.Key).ToList(); }
            @if (grupos.Count == 0)
            {
                <Vacio Icono="wallet" Titulo="Nada registrado este mes"
                       Detalle="Los gastos del banco entran solos. Para los de efectivo, toca el + de abajo." />
            }
            else
            {
                @foreach (var grupo in grupos)
                {
                    <div>
                        <div class="day-group-header">@NombreDia(grupo.Key)</div>
                        <div class="card">
                            <div class="stack" style="gap:0">
                                @foreach (var mov in grupo)
                                {
                                    var esIngreso = mov.Tipo == TipoCategoria.Ingreso;

                                    @if (_editandoId == mov.Id && mov.CategoriaNombre != CategoriaSinClasificar)
                                    {
                                        <EditorMovimiento Form="_editForm" Categorias="_categorias.Where(c => c.Activa).ToList()"
                                                          Guardando="_guardandoEdicion" Error="@_errorEdicion"
                                                          OnGuardar="GuardarEdicion" OnCancelar="CancelarEdicion" />
                                    }
                                    else
                                    {
                                    <div class="list-item">
                                        <div class="row">
                                            <div class="icon-bubble @(esIngreso ? "icon-bubble-accent" : "icon-bubble-danger")" style="font-size:18px">
                                                @mov.CategoriaIcono
                                            </div>
                                            <div>
                                                <div style="font-weight:600">@mov.CategoriaNombre</div>
                                                <div class="muted" style="font-size:12.5px">
                                                    @(string.IsNullOrEmpty(mov.Nota) ? mov.CategoriaNombre : mov.Nota)
                                                    @if (mov.RedondeoAplicado)
                                                    {
                                                        <span class="row" style="display:inline-flex; gap:2px; vertical-align:middle">
                                                            · <Icon Name="coin" Size="12" />
                                                        </span>
                                                    }
                                                    @if (mov.TarjetaCreditoNombre is not null)
                                                    {
                                                        <span class="row" style="display:inline-flex; gap:2px; vertical-align:middle" title="@mov.TarjetaCreditoNombre">
                                                            · <Icon Name="credit-card" Size="12" />
                                                        </span>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                        <div class="row" style="gap:4px">
                                            <span class="money" style="font-size:15px; color: @(esIngreso ? "var(--color-accent-strong)" : "var(--color-danger)")">
                                                @(esIngreso ? "+" : "-")@Formato.Pesos(mov.Monto)
                                            </span>
                                            <button class="icon-btn" style="width:30px;height:30px;background:transparent;border:none" @onclick="() => AbrirEdicion(mov)" title="Editar">
                                                <Icon Name="pencil" Size="14" />
                                            </button>
                                            <button class="icon-btn" style="width:30px;height:30px;background:transparent;border:none" @onclick="() => Eliminar(mov)" title="Eliminar">
                                                <Icon Name="x" Size="15" />
                                            </button>
                                        </div>
                                    </div>
                                    }
                                }
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
        }
    }
</div>

<button class="fab" @onclick="AbrirPantallaCompleta">
    <Icon Name="plus" Size="26" />
</button>

@if (_pegandoSms)
{
    <div class="fullscreen-modal">
        <div class="fullscreen-header">
            <button class="icon-btn" style="background:transparent;border:none" @onclick="() => _pegandoSms = false">
                <Icon Name="x" Size="22" />
            </button>
            <strong>Pegar SMS del banco</strong>
            <div style="width:40px"></div>
        </div>

        <div class="fullscreen-body">
            <p class="muted" style="font-size:13.5px; margin:0">
                Si el atajo no alcanzó a registrar algo, copia los mensajes del banco
                —los que sean, de una— y pégalos aquí. Los que ya estén registrados
                se ignoran solos.
            </p>

            <textarea class="input" rows="8" @bind="_textoSms" @bind:event="oninput"
                      placeholder="DAVIbank: Realizaste transaccion en ..."></textarea>

            @if (_resultadoSms is not null)
            {
                <div class="card">
                    <div class="stack">
                        <strong>
                            @(_resultadoSms.Registrados == 0
                                ? "No entró ninguno"
                                : $"Entraron {_resultadoSms.Registrados} de {_resultadoSms.Resultados.Count}")
                        </strong>
                        @foreach (var r in _resultadoSms.Resultados)
                        {
                            <div class="row-between" style="gap:10px; padding:4px 0">
                                <div style="min-width:0">
                                    <div style="font-size:13px; font-weight:600">
                                        @(r.Comercio ?? Recortar(r.Mensaje))
                                    </div>
                                    <div class="muted" style="font-size:12px">@r.Detalle</div>
                                </div>
                                <span class="money" style="font-size:14px; color:@(r.Registrado ? "var(--color-accent-strong)" : "var(--color-text-muted)")">
                                    @(r.Monto > 0 ? Formato.Pesos(r.Monto) : "—")
                                </span>
                            </div>
                        }
                    </div>
                </div>
            }

            <AlertBox Mensaje="@_errorSms" />
        </div>

        <div class="fullscreen-footer">
            <button class="btn btn-primary btn-block" disabled="@(_guardandoSms || string.IsNullOrWhiteSpace(_textoSms))"
                    @onclick="RegistrarDesdeSms">
                @if (_guardandoSms) { <span class="spinner"></span> }
                <span>Registrar</span>
            </button>
        </div>
    </div>
}

@if (_mostrarForm)
{
    <div class="fullscreen-modal">
        <div class="fullscreen-header">
            <button class="icon-btn" style="background:transparent;border:none" @onclick="CerrarPantallaCompleta">
                <Icon Name="x" Size="22" />
            </button>
            <div class="segmented" style="width: 200px">
                <button type="button" class="segmented-btn @(_form.Tipo == TipoCategoria.Gasto ? "active" : "")" @onclick="() => CambiarTipo(TipoCategoria.Gasto)">Gasto</button>
                <button type="button" class="segmented-btn @(_form.Tipo == TipoCategoria.Ingreso ? "active" : "")" @onclick="() => CambiarTipo(TipoCategoria.Ingreso)">Ingreso</button>
            </div>
            <div style="width:40px"></div>
        </div>

        <EditForm Model="_form" OnValidSubmit="Registrar" style="display:flex; flex-direction:column; flex:1; min-height:0">
            <div class="fullscreen-body">
                <div class="amount-entry" style="color: @(_form.Tipo == TipoCategoria.Ingreso ? "var(--color-accent-strong)" : "var(--color-danger)")">
                    <span class="currency">$</span>
                    <InputNumber @bind-Value="_form.Monto" placeholder="0" />
                </div>

                @{ var categoriasDisponibles = _categorias.Where(c => c.Tipo == _form.Tipo && c.Activa).ToList(); }
                @if (categoriasDisponibles.Count == 0)
                {
                    <div class="alert alert-warning">
                        <Icon Name="alert-triangle" Size="18" />
                        <span>
                            Todavía no tienes categorías de @(_form.Tipo == TipoCategoria.Gasto ? "gasto" : "ingreso").
                            <a href="/categorias">Créalas aquí</a> antes de registrar este movimiento.
                        </span>
                    </div>
                }
                else
                {
                    <div class="stack" style="gap:10px">
                        <span class="label">Categoría</span>
                        <div class="category-grid">
                            @foreach (var cat in categoriasDisponibles)
                            {
                                <div class="category-tile @(_form.CategoriaId == cat.Id ? "active" : "")" @onclick="() => _form.CategoriaId = cat.Id">
                                    <span class="emoji">@cat.Icono</span>
                                    <span class="name">@cat.Nombre</span>
                                </div>
                            }
                        </div>
                    </div>
                }

                @if (_form.Tipo == TipoCategoria.Gasto && _tarjetas.Count > 0)
                {
                    <div class="field">
                        <label>Pagado con (opcional)</label>
                        <InputSelect class="input" @bind-Value="_form.TarjetaCreditoId">
                            <option value="">Efectivo / débito</option>
                            @foreach (var tarjeta in _tarjetas)
                            {
                                <option value="@tarjeta.Id">@tarjeta.Nombre</option>
                            }
                        </InputSelect>
                    </div>
                }

                <div class="field">
                    <label>Nota (opcional)</label>
                    <InputText class="input" @bind-Value="_form.Nota" placeholder="Almuerzo" />
                </div>

                <AlertBox Mensaje="@_error" />
            </div>

            <div class="fullscreen-footer">
                <button class="btn btn-primary btn-block" type="submit" disabled="@(_guardando || categoriasDisponibles.Count == 0)">
                    @if (_guardando) { <span class="spinner"></span> }
                    <span>Guardar</span>
                </button>
            </div>
        </EditForm>
    </div>
}

@code {
    private static readonly string[] Paleta =
    [
        "#4fa78e", "#4f8fc0", "#e0925c", "#c9587a", "#7a63c9", "#8fae4a", "#d9a94e"
    ];

    private enum VistaResumen { Mes, Anio }

    private bool _cargando = true;
    private bool _guardando;
    private bool _mostrarForm;
    private string? _error;
    private VistaResumen _vista = VistaResumen.Mes;
    private DateTime _mesActual = new(DateTime.UtcNow.Year, DateTime.UtcNow.Month, 1);
    private int _anioActual = DateTime.UtcNow.Year;
    private List<CategoriaResponse> _categorias = [];
    private List<TarjetaCreditoResponse> _tarjetas = [];
    /// <summary>
    /// Debe coincidir con CategoriasPredefinidas en el API. Los movimientos
    /// que entran por el atajo caen acá porque el banco da el comercio pero
    /// no la categoría, y la app los resalta para que no se queden así: una
    /// categoría que parece decidida (como "Otros gastos") nadie la corrige.
    /// </summary>
    private const string CategoriaSinClasificar = "Sin clasificar";

    private List<MovimientoDiaADiaResponse> _movimientos = [];
    private int? _editandoId;
    private bool _guardandoEdicion;
    private string? _errorEdicion;

    /// <summary>
    /// Confirma que la corrección quedó guardada para ese comercio. Se muestra
    /// porque clasificar a mano solo se repite si se nota que sirve de algo:
    /// sin este aviso, el aprendizaje es invisible y parece que no pasó nada.
    /// </summary>
    private string? _avisoAprendizaje;

    private const string ClaveCache = "moneyback.diaadia";

    private bool _sinConexion;
    private DateTime? _guardadoEl;
    private List<MovimientoPendiente> _pendientes = [];
    private bool _subiendo;

    /// <summary>Lo que se guarda en el teléfono para poder abrir sin señal.</summary>
    private record CacheDiaADia(
        ResumenDiaADiaResponse? Saldo,
        List<MovimientoDiaADiaResponse> Movimientos,
        ResumenDiaADiaResponse? Resumen,
        DateTime GuardadoEl);

    private bool _pegandoSms;
    private bool _guardandoSms;
    private string? _textoSms;
    private string? _errorSms;
    private RegistroDesdeSmsResponse? _resultadoSms;
    private readonly EdicionMovimientoModel _editForm = new();
    private ResumenDiaADiaResponse? _resumen;
    private ResumenDiaADiaResponse? _saldoAcumulado;
    private readonly FormModel _form = new();

    /// <summary>
    /// Todas estas consultas son independientes entre sí, pero en serie
    /// sumaban ~8 viajes al servidor (~330ms cada uno = más de 2 segundos de
    /// pantalla vacía). En paralelo el costo es el de la más lenta, no el de
    /// la suma. Lo único encadenado de verdad es metas, que necesita el id
    /// del hogar.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        var desde = _mesActual;
        var hasta = _mesActual.AddMonths(1).AddTicks(-1);

        // Solo lo que hace falta para pintar la pantalla. Antes se esperaban
        // las seis llamadas antes de mostrar nada, así que la más lenta
        // marcaba el tiempo de todas y la app se quedaba en "Cargando"
        // aunque los gastos ya hubieran llegado.
        var saldoTask = Api.ObtenerResumenConEstadoAsync();
        var movimientosTask = Api.ObtenerMovimientosConEstadoAsync(desde, hasta);
        var resumenMesTask = Api.ObtenerResumenConEstadoAsync(desde, hasta);

        await Task.WhenAll(saldoTask, movimientosTask, resumenMesTask);

        await AplicarOUsarGuardadoAsync(await saldoTask, await movimientosTask, await resumenMesTask);
        _cargando = false;

        // El resto llega después y se repinta solo. Las categorías y las
        // tarjetas solo se necesitan al abrir el formulario, y las metas al
        // tocar "Aportar": nada de eso justifica retrasar lo que la persona
        // vino a ver.
        await CargarLoSecundarioAsync();
    }

    /// <summary>
    /// Conecta el día a día con el ahorro compartido: si solo hay una meta
    /// activa, no tiene sentido pedirle al usuario que la elija — se va
    /// directo a aportar. Con 0 o 2+, /hogar es quien decide qué mostrar
    /// (crear la primera, o elegir entre varias).
    /// </summary>
    private DestinoAporteResponse? _destinoAporte;

    /// <summary>
    /// Qué dice el botón. Nombrar la meta cuando se sabe cuál es le quita
    /// toda la duda a un gesto que debe ser inmediato.
    /// </summary>
    private string TextoDelBotonDeAporte() => _destinoAporte?.Caso switch
    {
        "SinMetas" => "Crear nuestra primera meta",
        "Unica" or "Favorita" => $"Aportar a {_destinoAporte.MetaIcono} {_destinoAporte.MetaNombre}",
        "Varias" => "Aportar a una meta",
        _ => "Aportar a nuestra meta"
    };

    /// <summary>
    /// A dónde lleva:
    ///
    /// Sin metas, a crearlas — no tiene sentido mandar a aportar a nada.
    /// Con una sola, directo: preguntar cuál sobra cuando hay una.
    /// Con favorita, directo a esa, aunque haya diez.
    /// Con varias y sin favorita, a elegir; y ahí se puede dejar marcada
    /// una para no volver a elegir nunca.
    /// </summary>
    private void AportarAMeta()
    {
        Nav.NavigateTo(_destinoAporte?.Caso switch
        {
            "Unica" or "Favorita" => $"/metas/{_destinoAporte.MetaId}",
            "Varias" => "/elegir-meta",
            _ => "/hogar"
        });
    }

    /// <summary>
    /// Soporte para el Botón de Acción del iPhone: un Atajo de iOS que abre
    /// "https://.../?accion=nuevo&amp;tipo=gasto" (o tipo=ingreso) llega aquí
    /// como una URL normal — no hay integración nativa con Siri/App Intents
    /// posible sin una app nativa, así que esto es "abrir directo en la
    /// pantalla de agregar" en vez de un atajo del sistema operativo real.
    /// Se limpia el query string después para que un refresh no lo reabra.
    /// </summary>
    private void AbrirDesdeAtajoSiCorresponde()
    {
        var query = QueryHelpers.ParseQuery(new Uri(Nav.Uri).Query);
        if (!query.TryGetValue("accion", out var accion) || accion != "nuevo") return;

        var tipo = query.TryGetValue("tipo", out var t) && t == "ingreso" ? TipoCategoria.Ingreso : TipoCategoria.Gasto;
        AbrirPantallaCompleta();
        CambiarTipo(tipo);

        Nav.NavigateTo("/", replace: true);
    }

    private async Task CambiarVista(VistaResumen vista)
    {
        _vista = vista;
        if (vista == VistaResumen.Mes) await CargarMesAsync();
        else await CargarAnioAsync();
    }

    /// <summary>
    /// Lo que no bloquea la primera pintada. Se trae en segundo plano y la
    /// pantalla se actualiza cuando llega.
    /// </summary>
    /// <summary>
    /// Usa lo que llegó del servidor y lo guarda para la próxima; si no
    /// llegó, muestra lo guardado con el aviso de que puede estar viejo.
    ///
    /// Enseñar ceros porque no hubo conexión es peor que enseñar cifras de
    /// hace dos horas: los ceros parecen un dato y llevan a decisiones
    /// equivocadas, lo viejo con su fecha es información honesta.
    /// </summary>
    private async Task AplicarOUsarGuardadoAsync(
        ApiResult<ResumenDiaADiaResponse> saldo,
        ApiResult<List<MovimientoDiaADiaResponse>> movimientos,
        ApiResult<ResumenDiaADiaResponse> resumenMes)
    {
        if (movimientos.Exito && saldo.Exito && resumenMes.Exito)
        {
            _saldoAcumulado = saldo.Valor;
            _movimientos = movimientos.Valor!;
            _resumen = resumenMes.Valor;
            _sinConexion = false;
            _guardadoEl = DateTime.Now;

            await Almacen.GuardarAsync(ClaveCache, new CacheDiaADia(_saldoAcumulado, _movimientos, _resumen, _guardadoEl.Value));
            await SubirPendientesAsync();
            return;
        }

        if (!movimientos.EsFalloDeRed) return;

        var guardado = await Almacen.LeerAsync<CacheDiaADia>(ClaveCache);
        if (guardado is null) { _sinConexion = true; return; }

        _saldoAcumulado = guardado.Saldo;
        _movimientos = guardado.Movimientos;
        _resumen = guardado.Resumen;
        _guardadoEl = guardado.GuardadoEl;
        _sinConexion = true;
    }

    private async Task ReintentarSubida()
    {
        _subiendo = true;
        await SubirPendientesAsync();
        _subiendo = false;
    }

    private async Task SubirPendientesAsync()
    {
        _pendientes = await Cola.ListarAsync();
        if (_pendientes.Count == 0) return;

        var subidos = await Cola.SubirPendientesAsync();
        _pendientes = await Cola.ListarAsync();

        if (subidos > 0)
        {
            _avisoAprendizaje = subidos == 1
                ? "Se subió 1 gasto que quedó pendiente sin conexión."
                : $"Se subieron {subidos} gastos que quedaron pendientes sin conexión.";

            var desde = _mesActual;
            var hasta = _mesActual.AddMonths(1).AddTicks(-1);
            _movimientos = await Api.ObtenerMovimientosDiaADiaAsync(desde, hasta);
            _saldoAcumulado = await Api.ObtenerResumenDiaADiaAsync();
            _resumen = await Api.ObtenerResumenDiaADiaAsync(desde, hasta);
        }
    }

    private async Task CargarLoSecundarioAsync()
    {
        // Las tres en paralelo y nada encadenado detrás. Antes se pedía
        // además el hogar y sus metas para llenar un campo que nadie leía, y
        // como iban en serie el destino del botón llegaba cuatro viajes
        // después de abrir la pantalla: durante ese rato el botón decía
        // "Aportar a nuestra meta" y luego cambiaba solo.
        var categoriasTask = Api.ObtenerCategoriasAsync();
        var tarjetasTask = Api.ObtenerTarjetasCreditoAsync();
        var destinoTask = Api.ObtenerDestinoAporteAsync();

        await Task.WhenAll(categoriasTask, tarjetasTask, destinoTask);

        _categorias = await categoriasTask;
        _tarjetas = (await tarjetasTask).Where(t => t.Activa).ToList();
        _destinoAporte = await destinoTask;
        StateHasChanged();

        // Va de último porque abre el formulario, y para eso necesita las
        // categorías ya cargadas.
        AbrirDesdeAtajoSiCorresponde();
    }

    private async Task CargarMesAsync()
    {
        _cargando = true;
        var desde = _mesActual;
        var hasta = _mesActual.AddMonths(1).AddTicks(-1);
        _movimientos = await Api.ObtenerMovimientosDiaADiaAsync(desde, hasta);
        _resumen = await Api.ObtenerResumenDiaADiaAsync(desde, hasta);
        _cargando = false;

        await ActualizarGloboAsync();
    }

    private async Task CargarAnioAsync()
    {
        _cargando = true;
        var desde = new DateTime(_anioActual, 1, 1);
        var hasta = new DateTime(_anioActual, 12, 31, 23, 59, 59);
        _resumen = await Api.ObtenerResumenDiaADiaAsync(desde, hasta);
        _cargando = false;
    }

    private async Task MesAnterior()
    {
        _mesActual = _mesActual.AddMonths(-1);
        await CargarMesAsync();
    }

    private async Task MesSiguiente()
    {
        _mesActual = _mesActual.AddMonths(1);
        await CargarMesAsync();
    }

    private async Task CambiarAnio(int delta)
    {
        _anioActual += delta;
        await CargarAnioAsync();
    }

    private void AbrirPantallaCompleta()
    {
        _mostrarForm = true;
        _error = null;
        CambiarTipo(_form.Tipo);
        UiOverlay.AbrirModal();
    }

    private void CerrarPantallaCompleta()
    {
        _mostrarForm = false;
        UiOverlay.CerrarModal();
    }

    public void Dispose()
    {
        if (_mostrarForm) UiOverlay.CerrarModal();
    }

    private void CambiarTipo(TipoCategoria tipo)
    {
        _form.Tipo = tipo;
        var primeraCategoria = _categorias.FirstOrDefault(c => c.Tipo == tipo && c.Activa);
        _form.CategoriaId = primeraCategoria?.Id ?? 0;
        _form.TarjetaCreditoId = null;
    }

    private async Task Registrar()
    {
        _error = null;
        _guardando = true;

        var resultado = await Api.RegistrarMovimientoDiaADiaAsync(new CrearMovimientoDiaADiaRequest(
            _form.CategoriaId, _form.Monto, null, _form.Nota, _form.TarjetaCreditoId));

        if (resultado.Exito)
        {
            CerrarFormulario();
            _saldoAcumulado = await Api.ObtenerResumenDiaADiaAsync();
            await CargarMesAsync();
        }
        else if (resultado.EsFalloDeRed)
        {
            // Sin señal el gasto NO se pierde: se guarda en el teléfono y
            // sube solo cuando vuelva la conexión. Anotar tiene que
            // funcionar siempre —uno registra en el ascensor, en un
            // parqueadero, en el bus— y quien pierde un par de gastos por
            // un error de red deja de confiar en los totales.
            var categoria = _categorias.First(c => c.Id == _form.CategoriaId);

            await Cola.AgregarAsync(new MovimientoPendiente(
                Guid.NewGuid().ToString("N"), categoria.Id, categoria.Nombre, categoria.Icono,
                categoria.Tipo, _form.Monto, DateTime.UtcNow, _form.Nota, _form.TarjetaCreditoId));

            _pendientes = await Cola.ListarAsync();
            _sinConexion = true;
            CerrarFormulario();
        }
        else
        {
            _error = resultado.TodosLosErrores();
        }

        _guardando = false;
    }

    private void CerrarFormulario()
    {
        _mostrarForm = false;
        UiOverlay.CerrarModal();
        _form.Monto = 0;
        _form.Nota = "";
        _form.TarjetaCreditoId = null;
    }

    /// <summary>
    /// Pregunta antes de borrar. El botón mide 30 píxeles y está pegado al
    /// de editar: sin esta pregunta, un roce con el pulgar borraba un gasto
    /// para siempre y sin forma de recuperarlo.
    /// </summary>
    private async Task Eliminar(MovimientoDiaADiaResponse mov)
    {
        var confirmado = await Confirmacion.PreguntarAsync(new Confirmacion(
            $"¿Borrar este {(mov.Tipo == TipoCategoria.Ingreso ? "ingreso" : "gasto")} de {Formato.Pesos(mov.Monto)}?",
            $"{mov.CategoriaNombre} · {Formato.FechaHora(mov.Fecha.ToLocalTime())}. No se puede deshacer.",
            "Sí, borrarlo"));
        if (!confirmado) return;

        await Api.EliminarMovimientoDiaADiaAsync(mov.Id);
        _saldoAcumulado = await Api.ObtenerResumenDiaADiaAsync();
        await CargarMesAsync();
    }

    private void AbrirEdicion(MovimientoDiaADiaResponse mov)
    {
        _errorEdicion = null;
        _avisoAprendizaje = null;
        _editandoId = mov.Id;
        _editForm.CategoriaId = mov.CategoriaId;
        _editForm.Monto = mov.Monto;
        _editForm.Nota = mov.Nota;
        // Se conserva la tarjeta: editar la categoría de una compra no debería
        // borrar sin avisar el vínculo con la tarjeta y descuadrar su saldo.
        _editForm.TarjetaCreditoId = mov.TarjetaCreditoId;
    }

    private void CancelarEdicion()
    {
        _editandoId = null;
        _errorEdicion = null;
    }

    /// <summary>
    /// Pone el globo del ícono con los gastos que faltan por clasificar.
    ///
    /// Es lo más cerca que puede estar una PWA de la isla dinámica: las Live
    /// Activities necesitan ActivityKit y eso es solo para apps nativas. El
    /// globo sí existe en iOS desde la 16.4 y cumple la misma función — ver
    /// que hay algo pendiente sin abrir nada.
    ///
    /// Solo se usa para esto. Es el único número de la app que representa
    /// algo que la persona tiene que hacer; ponerle globo a cualquier otra
    /// cosa la entrenaría a ignorarlo.
    /// </summary>
    private async Task ActualizarGloboAsync()
    {
        try
        {
            var pendientes = _movimientos.Count(m => m.CategoriaNombre == CategoriaSinClasificar);
            var modulo = await JS.InvokeAsync<IJSObjectReference>("import", "./js/interop.js");
            await modulo.InvokeVoidAsync("marcarPendientes", pendientes);
        }
        catch
        {
            // El globo es un extra. Si el navegador no lo soporta o el
            // módulo no carga, la pantalla tiene que seguir funcionando.
        }
    }

    private static string Recortar(string texto) =>
        texto.Length <= 40 ? texto : texto[..40] + "…";

    private void AbrirPegarSms()
    {
        _errorSms = null;
        _resultadoSms = null;
        _textoSms = "";
        _pegandoSms = true;
    }

    private async Task RegistrarDesdeSms()
    {
        _errorSms = null;
        _guardandoSms = true;

        var resultado = await Api.RegistrarDesdeSmsAsync(_textoSms ?? "");

        if (resultado.Exito)
        {
            _resultadoSms = resultado.Valor;
            _textoSms = "";
            _saldoAcumulado = await Api.ObtenerResumenDiaADiaAsync();
            await CargarMesAsync();
        }
        else
        {
            _errorSms = resultado.TodosLosErrores();
        }

        _guardandoSms = false;
    }

    private async Task GuardarEdicion()
    {
        if (_editandoId is null) return;
        _errorEdicion = null;
        _guardandoEdicion = true;

        var resultado = await Api.ActualizarMovimientoDiaADiaAsync(_editandoId.Value,
            new ActualizarMovimientoDiaADiaRequest(
                _editForm.CategoriaId, _editForm.Monto ?? 0, null, _editForm.Nota, _editForm.TarjetaCreditoId));

        if (resultado.Exito)
        {
            _avisoAprendizaje = ArmarAvisoAprendizaje(resultado.Valor!);
            _editandoId = null;
            _saldoAcumulado = await Api.ObtenerResumenDiaADiaAsync();
            await CargarMesAsync();
        }
        else
        {
            _errorEdicion = resultado.TodosLosErrores();
        }

        _guardandoEdicion = false;
    }

    /// <summary>
    /// Solo avisa si el API confirmó que guardó algo. Deducirlo de la nota
    /// hacía que corregir únicamente el monto anunciara un aprendizaje que
    /// nunca ocurrió, y un aviso que no corresponde a lo que pasó le enseña a
    /// la persona a no creerle a ninguno.
    /// </summary>
    private static string? ArmarAvisoAprendizaje(MovimientoActualizadoResponse resultado)
    {
        var comercio = resultado.ComercioAprendido;
        if (string.IsNullOrWhiteSpace(comercio)) return null;

        var aprendio = $"Listo: los próximos gastos en {comercio} entran como {resultado.Movimiento.CategoriaNombre}.";

        return resultado.OtrosReclasificados == 0
            ? aprendio
            : resultado.OtrosReclasificados == 1
                ? $"{aprendio} También moví 1 gasto anterior del mismo sitio."
                : $"{aprendio} También moví {resultado.OtrosReclasificados} gastos anteriores del mismo sitio.";
    }


    private string DonutGradient()
    {
        if (_resumen is null || _resumen.TotalGastos <= 0) return "var(--color-surface-2)";

        var partes = new List<string>();
        decimal acumulado = 0;
        for (var i = 0; i < _resumen.GastosPorCategoria.Count; i++)
        {
            var cat = _resumen.GastosPorCategoria[i];
            var color = Paleta[i % Paleta.Length];
            var inicio = acumulado / _resumen.TotalGastos * 360;
            acumulado += cat.Total;
            var fin = acumulado / _resumen.TotalGastos * 360;
            partes.Add($"{color} {inicio:0.##}deg {fin:0.##}deg");
        }
        return $"conic-gradient({string.Join(", ", partes)})";
    }

    private static string NombreMes(DateTime fecha)
    {
        string[] meses = ["enero", "febrero", "marzo", "abril", "mayo", "junio", "julio", "agosto", "septiembre", "octubre", "noviembre", "diciembre"];
        return $"{meses[fecha.Month - 1]} {fecha.Year}";
    }

    private static string NombreDia(DateTime fecha)
    {
        string[] dias = ["domingo", "lunes", "martes", "miércoles", "jueves", "viernes", "sábado"];
        string[] meses = ["ene", "feb", "mar", "abr", "may", "jun", "jul", "ago", "sep", "oct", "nov", "dic"];
        var hoy = DateTime.UtcNow.ToLocalTime().Date;
        if (fecha == hoy) return "Hoy";
        if (fecha == hoy.AddDays(-1)) return "Ayer";
        return $"{dias[(int)fecha.DayOfWeek]} {fecha.Day} {meses[fecha.Month - 1]}";
    }

