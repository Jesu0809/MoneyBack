@page "/"
@attribute [Authorize]
@using Microsoft.AspNetCore.WebUtilities
@inject ApiClient Api
@inject UiOverlayService UiOverlay
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Día a día · MoneyBack</PageTitle>

<div class="stack">
    <div class="hero-balance">
        <div class="stack" style="gap:10px">
            <span class="label">Saldo acumulado</span>
            <AnimatedMoney Valor="_saldoAcumulado?.Balance ?? 0" Class="money money-lg" />
            <div class="divider"></div>
            <div class="row-between">
                <span class="muted">Ingresos totales</span>
                <span style="font-weight:650">@Formato.Pesos(_saldoAcumulado?.TotalIngresos ?? 0)</span>
            </div>
            <div class="row-between">
                <span class="muted">Gastos totales</span>
                <span style="font-weight:650">@Formato.Pesos(_saldoAcumulado?.TotalGastos ?? 0)</span>
            </div>
            <button class="btn btn-secondary btn-block" @onclick="AportarAMeta">
                <Icon Name="coin" Size="16" /> Aportar a nuestra meta
            </button>
        </div>
    </div>

    @{ var sinClasificar = _movimientos.Where(m => m.CategoriaNombre == CategoriaSinClasificar).ToList(); }
    @if (sinClasificar.Count > 0)
    {
        <div class="card" style="border-left:3px solid var(--color-warning)">
            <div class="stack">
                <div class="row" style="gap:8px">
                    <Icon Name="alert-triangle" Size="17" />
                    <strong>@sinClasificar.Count @(sinClasificar.Count == 1 ? "gasto sin clasificar" : "gastos sin clasificar")</strong>
                </div>
                <p class="muted" style="font-size:13px; margin:0">
                    Entraron solos desde tu banco. Esto es lo que el banco informó de cada uno —
                    dónde y cuándo fue — para que puedas reconocerlos. Mientras no tengan categoría,
                    tus reportes quedan incompletos.
                </p>
                @foreach (var m in sinClasificar)
                {
                    @if (_editandoId == m.Id)
                    {
                        <EditorMovimiento Form="_editForm" Categorias="_categorias.Where(c => c.Activa).ToList()"
                                          Guardando="_guardandoEdicion" Error="@_errorEdicion"
                                          OnGuardar="GuardarEdicion" OnCancelar="CancelarEdicion" />
                    }
                    else
                    {
                        <div class="row-between card-tap" style="padding:10px 0" @onclick="() => AbrirEdicion(m)">
                            <div class="row" style="gap:10px">
                                <div class="icon-bubble" style="background:var(--color-warning-soft)">
                                    <Icon Name="alert-triangle" Size="15" />
                                </div>
                                <div>
                                    <div style="font-weight:600">
                                        @(string.IsNullOrEmpty(m.Nota) ? "El banco no dijo dónde" : m.Nota)
                                    </div>
                                    <div class="muted" style="font-size:12.5px">
                                        @Formato.FechaHora(m.Fecha) · toca para clasificar
                                    </div>
                                </div>
                            </div>
                            <span class="money" style="font-size:15px; color:var(--color-danger)">
                                @Formato.Pesos(m.Monto)
                            </span>
                        </div>
                    }
                }
                <span class="muted" style="font-size:12px">Toca uno para decirle a qué categoría pertenece.</span>
            </div>
        </div>
    }

    <div class="segmented" style="width:200px; margin: 0 auto">
        <button type="button" class="segmented-btn @(_vista == VistaResumen.Mes ? "active" : "")" @onclick="() => CambiarVista(VistaResumen.Mes)">Mes</button>
        <button type="button" class="segmented-btn @(_vista == VistaResumen.Anio ? "active" : "")" @onclick="() => CambiarVista(VistaResumen.Anio)">Año</button>
    </div>

    @if (_vista == VistaResumen.Mes)
    {
        <div class="row-between">
            <button class="icon-btn glass" @onclick="MesAnterior"><Icon Name="chevron-left" /></button>
            <strong>@NombreMes(_mesActual)</strong>
            <button class="icon-btn glass" @onclick="MesSiguiente"><Icon Name="chevron-right" /></button>
        </div>
    }
    else
    {
        <div class="row-between">
            <button class="icon-btn glass" @onclick="() => CambiarAnio(-1)"><Icon Name="chevron-left" /></button>
            <strong>@_anioActual</strong>
            <button class="icon-btn glass" @onclick="() => CambiarAnio(1)"><Icon Name="chevron-right" /></button>
        </div>
    }

    @if (_cargando)
    {
        <div class="center-screen"><div class="spinner spinner-accent"></div></div>
    }
    else
    {
        <div class="card">
            <div class="row" style="justify-content: space-around; text-align:center">
                <div class="stack" style="gap:4px; align-items:center">
                    <div class="icon-bubble icon-bubble-accent"><Icon Name="arrow-up" Size="16" /></div>
                    <span class="muted" style="font-size:12.5px">Ingresos</span>
                    <span style="font-weight:700; color: var(--color-accent-strong)">@Formato.Pesos(_resumen?.TotalIngresos ?? 0)</span>
                </div>
                <div class="stack" style="gap:4px; align-items:center">
                    <div class="icon-bubble icon-bubble-danger"><Icon Name="arrow-down" Size="16" /></div>
                    <span class="muted" style="font-size:12.5px">Gastos</span>
                    <span style="font-weight:700; color: var(--color-danger)">@Formato.Pesos(_resumen?.TotalGastos ?? 0)</span>
                </div>
                <div class="stack" style="gap:4px; align-items:center">
                    <div class="icon-bubble" style="background:var(--color-surface-2)"><Icon Name="wallet" Size="16" /></div>
                    <span class="muted" style="font-size:12.5px">Balance</span>
                    <span style="font-weight:700">@Formato.Pesos(_resumen?.Balance ?? 0)</span>
                </div>
            </div>
        </div>

        @if (_resumen is { GastosPorCategoria.Count: > 0 })
        {
            <div class="card">
                <div class="stack">
                    <div class="label">Gastos por categoría</div>
                    <div class="donut" style="background: @DonutGradient()">
                        <div class="donut-center">
                            <div class="muted" style="font-size:11.5px">Total</div>
                            <div class="money">@Formato.Pesos(_resumen.TotalGastos)</div>
                        </div>
                    </div>
                    @for (var i = 0; i < _resumen.GastosPorCategoria.Count; i++)
                    {
                        var cat = _resumen.GastosPorCategoria[i];
                        var pct = _resumen.TotalGastos > 0 ? cat.Total / _resumen.TotalGastos * 100 : 0;
                        <div class="row-between">
                            <div class="row" style="gap:8px">
                                <div class="category-dot" style="background: @Paleta[i % Paleta.Length]"></div>
                                <span>@cat.CategoriaIcono @cat.CategoriaNombre</span>
                            </div>
                            <div class="row" style="gap:8px">
                                <span class="muted" style="font-size:12.5px">@Formato.Porcentaje(pct)</span>
                                <span class="money" style="font-size:14.5px">@Formato.Pesos(cat.Total)</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        @if (_vista == VistaResumen.Anio)
        {
            <div class="empty-state">
                <p>Este es el resumen del año completo. Para ver el detalle día por día, cambia a "Mes", o entra a <a href="/reportes">Reportes</a> para más detalle y descargas.</p>
            </div>
        }
        else
        {
        <div class="stack">
            @{ var grupos = _movimientos.GroupBy(m => m.Fecha.ToLocalTime().Date).OrderByDescending(g => g.Key).ToList(); }
            @if (grupos.Count == 0)
            {
                <div class="empty-state">
                    <p>Nada registrado este mes todavía.</p>
                </div>
            }
            else
            {
                @foreach (var grupo in grupos)
                {
                    <div>
                        <div class="day-group-header">@NombreDia(grupo.Key)</div>
                        <div class="card">
                            <div class="stack" style="gap:0">
                                @foreach (var mov in grupo)
                                {
                                    var esIngreso = mov.Tipo == TipoCategoria.Ingreso;

                                    @if (_editandoId == mov.Id && mov.CategoriaNombre != CategoriaSinClasificar)
                                    {
                                        <EditorMovimiento Form="_editForm" Categorias="_categorias.Where(c => c.Activa).ToList()"
                                                          Guardando="_guardandoEdicion" Error="@_errorEdicion"
                                                          OnGuardar="GuardarEdicion" OnCancelar="CancelarEdicion" />
                                    }
                                    else
                                    {
                                    <div class="list-item">
                                        <div class="row">
                                            <div class="icon-bubble @(esIngreso ? "icon-bubble-accent" : "icon-bubble-danger")" style="font-size:18px">
                                                @mov.CategoriaIcono
                                            </div>
                                            <div>
                                                <div style="font-weight:600">@mov.CategoriaNombre</div>
                                                <div class="muted" style="font-size:12.5px">
                                                    @(string.IsNullOrEmpty(mov.Nota) ? mov.CategoriaNombre : mov.Nota)
                                                    @if (mov.RedondeoAplicado)
                                                    {
                                                        <span class="row" style="display:inline-flex; gap:2px; vertical-align:middle">
                                                            · <Icon Name="coin" Size="12" />
                                                        </span>
                                                    }
                                                    @if (mov.TarjetaCreditoNombre is not null)
                                                    {
                                                        <span class="row" style="display:inline-flex; gap:2px; vertical-align:middle" title="@mov.TarjetaCreditoNombre">
                                                            · <Icon Name="credit-card" Size="12" />
                                                        </span>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                        <div class="row" style="gap:4px">
                                            <span class="money" style="font-size:15px; color: @(esIngreso ? "var(--color-accent-strong)" : "var(--color-danger)")">
                                                @(esIngreso ? "+" : "-")@Formato.Pesos(mov.Monto)
                                            </span>
                                            <button class="icon-btn" style="width:30px;height:30px;background:transparent;border:none" @onclick="() => AbrirEdicion(mov)" title="Editar">
                                                <Icon Name="pencil" Size="14" />
                                            </button>
                                            <button class="icon-btn" style="width:30px;height:30px;background:transparent;border:none" @onclick="() => Eliminar(mov.Id)" title="Eliminar">
                                                <Icon Name="x" Size="15" />
                                            </button>
                                        </div>
                                    </div>
                                    }
                                }
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
        }
    }
</div>

<button class="fab" @onclick="AbrirPantallaCompleta">
    <Icon Name="plus" Size="26" />
</button>

@if (_mostrarForm)
{
    <div class="fullscreen-modal">
        <div class="fullscreen-header">
            <button class="icon-btn" style="background:transparent;border:none" @onclick="CerrarPantallaCompleta">
                <Icon Name="x" Size="22" />
            </button>
            <div class="segmented" style="width: 200px">
                <button type="button" class="segmented-btn @(_form.Tipo == TipoCategoria.Gasto ? "active" : "")" @onclick="() => CambiarTipo(TipoCategoria.Gasto)">Gasto</button>
                <button type="button" class="segmented-btn @(_form.Tipo == TipoCategoria.Ingreso ? "active" : "")" @onclick="() => CambiarTipo(TipoCategoria.Ingreso)">Ingreso</button>
            </div>
            <div style="width:40px"></div>
        </div>

        <EditForm Model="_form" OnValidSubmit="Registrar" style="display:flex; flex-direction:column; flex:1; min-height:0">
            <div class="fullscreen-body">
                <div class="amount-entry" style="color: @(_form.Tipo == TipoCategoria.Ingreso ? "var(--color-accent-strong)" : "var(--color-danger)")">
                    <span class="currency">$</span>
                    <InputNumber @bind-Value="_form.Monto" placeholder="0" />
                </div>

                @{ var categoriasDisponibles = _categorias.Where(c => c.Tipo == _form.Tipo && c.Activa).ToList(); }
                @if (categoriasDisponibles.Count == 0)
                {
                    <div class="alert alert-warning">
                        <Icon Name="alert-triangle" Size="18" />
                        <span>
                            Todavía no tienes categorías de @(_form.Tipo == TipoCategoria.Gasto ? "gasto" : "ingreso").
                            <a href="/categorias">Créalas aquí</a> antes de registrar este movimiento.
                        </span>
                    </div>
                }
                else
                {
                    <div class="stack" style="gap:10px">
                        <span class="label">Categoría</span>
                        <div class="category-grid">
                            @foreach (var cat in categoriasDisponibles)
                            {
                                <div class="category-tile @(_form.CategoriaId == cat.Id ? "active" : "")" @onclick="() => _form.CategoriaId = cat.Id">
                                    <span class="emoji">@cat.Icono</span>
                                    <span class="name">@cat.Nombre</span>
                                </div>
                            }
                        </div>
                    </div>
                }

                @if (_form.Tipo == TipoCategoria.Gasto && _tarjetas.Count > 0)
                {
                    <div class="field">
                        <label>Pagado con (opcional)</label>
                        <InputSelect class="input" @bind-Value="_form.TarjetaCreditoId">
                            <option value="">Efectivo / débito</option>
                            @foreach (var tarjeta in _tarjetas)
                            {
                                <option value="@tarjeta.Id">@tarjeta.Nombre</option>
                            }
                        </InputSelect>
                    </div>
                }

                <div class="field">
                    <label>Nota (opcional)</label>
                    <InputText class="input" @bind-Value="_form.Nota" placeholder="Almuerzo" />
                </div>

                <AlertBox Mensaje="@_error" />
            </div>

            <div class="fullscreen-footer">
                <button class="btn btn-primary btn-block" type="submit" disabled="@(_guardando || categoriasDisponibles.Count == 0)">
                    @if (_guardando) { <span class="spinner"></span> }
                    <span>Guardar</span>
                </button>
            </div>
        </EditForm>
    </div>
}

@code {
    private static readonly string[] Paleta =
    [
        "#4fa78e", "#4f8fc0", "#e0925c", "#c9587a", "#7a63c9", "#8fae4a", "#d9a94e"
    ];

    private enum VistaResumen { Mes, Anio }

    private bool _cargando = true;
    private bool _guardando;
    private bool _mostrarForm;
    private string? _error;
    private VistaResumen _vista = VistaResumen.Mes;
    private DateTime _mesActual = new(DateTime.UtcNow.Year, DateTime.UtcNow.Month, 1);
    private int _anioActual = DateTime.UtcNow.Year;
    private List<CategoriaResponse> _categorias = [];
    private List<TarjetaCreditoResponse> _tarjetas = [];
    /// <summary>
    /// Debe coincidir con CategoriasPredefinidas en el API. Los movimientos
    /// que entran por el atajo caen acá porque el banco da el comercio pero
    /// no la categoría, y la app los resalta para que no se queden así: una
    /// categoría que parece decidida (como "Otros gastos") nadie la corrige.
    /// </summary>
    private const string CategoriaSinClasificar = "Sin clasificar";

    private List<MovimientoDiaADiaResponse> _movimientos = [];
    private int? _editandoId;
    private bool _guardandoEdicion;
    private string? _errorEdicion;
    private readonly EdicionMovimientoModel _editForm = new();
    private ResumenDiaADiaResponse? _resumen;
    private ResumenDiaADiaResponse? _saldoAcumulado;
    private List<MetaResponse> _metasActivas = [];
    private readonly FormModel _form = new();

    /// <summary>
    /// Todas estas consultas son independientes entre sí, pero en serie
    /// sumaban ~8 viajes al servidor (~330ms cada uno = más de 2 segundos de
    /// pantalla vacía). En paralelo el costo es el de la más lenta, no el de
    /// la suma. Lo único encadenado de verdad es metas, que necesita el id
    /// del hogar.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        var desde = _mesActual;
        var hasta = _mesActual.AddMonths(1).AddTicks(-1);

        var categoriasTask = Api.ObtenerCategoriasAsync();
        var tarjetasTask = Api.ObtenerTarjetasCreditoAsync();
        var saldoTask = Api.ObtenerResumenDiaADiaAsync();
        var movimientosTask = Api.ObtenerMovimientosDiaADiaAsync(desde, hasta);
        var resumenMesTask = Api.ObtenerResumenDiaADiaAsync(desde, hasta);
        var hogarTask = Api.ObtenerMiHogarAsync();

        await Task.WhenAll(categoriasTask, tarjetasTask, saldoTask, movimientosTask, resumenMesTask, hogarTask);

        _categorias = await categoriasTask;
        _tarjetas = (await tarjetasTask).Where(t => t.Activa).ToList();
        _saldoAcumulado = await saldoTask;
        _movimientos = await movimientosTask;
        _resumen = await resumenMesTask;
        _cargando = false;

        var hogar = await hogarTask;
        if (hogar is not null)
        {
            _metasActivas = (await Api.ObtenerMetasAsync(hogar.Id)).Where(m => m.Activa).ToList();
        }

        AbrirDesdeAtajoSiCorresponde();
    }

    /// <summary>
    /// Conecta el día a día con el ahorro compartido: si solo hay una meta
    /// activa, no tiene sentido pedirle al usuario que la elija — se va
    /// directo a aportar. Con 0 o 2+, /hogar es quien decide qué mostrar
    /// (crear la primera, o elegir entre varias).
    /// </summary>
    private void AportarAMeta()
    {
        Nav.NavigateTo(_metasActivas.Count == 1 ? $"/metas/{_metasActivas[0].Id}" : "/hogar");
    }

    /// <summary>
    /// Soporte para el Botón de Acción del iPhone: un Atajo de iOS que abre
    /// "https://.../?accion=nuevo&amp;tipo=gasto" (o tipo=ingreso) llega aquí
    /// como una URL normal — no hay integración nativa con Siri/App Intents
    /// posible sin una app nativa, así que esto es "abrir directo en la
    /// pantalla de agregar" en vez de un atajo del sistema operativo real.
    /// Se limpia el query string después para que un refresh no lo reabra.
    /// </summary>
    private void AbrirDesdeAtajoSiCorresponde()
    {
        var query = QueryHelpers.ParseQuery(new Uri(Nav.Uri).Query);
        if (!query.TryGetValue("accion", out var accion) || accion != "nuevo") return;

        var tipo = query.TryGetValue("tipo", out var t) && t == "ingreso" ? TipoCategoria.Ingreso : TipoCategoria.Gasto;
        AbrirPantallaCompleta();
        CambiarTipo(tipo);

        Nav.NavigateTo("/", replace: true);
    }

    private async Task CambiarVista(VistaResumen vista)
    {
        _vista = vista;
        if (vista == VistaResumen.Mes) await CargarMesAsync();
        else await CargarAnioAsync();
    }

    private async Task CargarMesAsync()
    {
        _cargando = true;
        var desde = _mesActual;
        var hasta = _mesActual.AddMonths(1).AddTicks(-1);
        _movimientos = await Api.ObtenerMovimientosDiaADiaAsync(desde, hasta);
        _resumen = await Api.ObtenerResumenDiaADiaAsync(desde, hasta);
        _cargando = false;
    }

    private async Task CargarAnioAsync()
    {
        _cargando = true;
        var desde = new DateTime(_anioActual, 1, 1);
        var hasta = new DateTime(_anioActual, 12, 31, 23, 59, 59);
        _resumen = await Api.ObtenerResumenDiaADiaAsync(desde, hasta);
        _cargando = false;
    }

    private async Task MesAnterior()
    {
        _mesActual = _mesActual.AddMonths(-1);
        await CargarMesAsync();
    }

    private async Task MesSiguiente()
    {
        _mesActual = _mesActual.AddMonths(1);
        await CargarMesAsync();
    }

    private async Task CambiarAnio(int delta)
    {
        _anioActual += delta;
        await CargarAnioAsync();
    }

    private void AbrirPantallaCompleta()
    {
        _mostrarForm = true;
        _error = null;
        CambiarTipo(_form.Tipo);
        UiOverlay.AbrirModal();
    }

    private void CerrarPantallaCompleta()
    {
        _mostrarForm = false;
        UiOverlay.CerrarModal();
    }

    public void Dispose()
    {
        if (_mostrarForm) UiOverlay.CerrarModal();
    }

    private void CambiarTipo(TipoCategoria tipo)
    {
        _form.Tipo = tipo;
        var primeraCategoria = _categorias.FirstOrDefault(c => c.Tipo == tipo && c.Activa);
        _form.CategoriaId = primeraCategoria?.Id ?? 0;
        _form.TarjetaCreditoId = null;
    }

    private async Task Registrar()
    {
        _error = null;
        _guardando = true;

        var resultado = await Api.RegistrarMovimientoDiaADiaAsync(new CrearMovimientoDiaADiaRequest(
            _form.CategoriaId, _form.Monto, null, _form.Nota, _form.TarjetaCreditoId));

        if (resultado.Exito)
        {
            _mostrarForm = false;
            UiOverlay.CerrarModal();
            _form.Monto = 0;
            _form.Nota = "";
            _form.TarjetaCreditoId = null;
            _saldoAcumulado = await Api.ObtenerResumenDiaADiaAsync();
            await CargarMesAsync();
        }
        else
        {
            _error = resultado.TodosLosErrores();
        }

        _guardando = false;
    }

    private async Task Eliminar(int id)
    {
        await Api.EliminarMovimientoDiaADiaAsync(id);
        _saldoAcumulado = await Api.ObtenerResumenDiaADiaAsync();
        await CargarMesAsync();
    }

    private void AbrirEdicion(MovimientoDiaADiaResponse mov)
    {
        _errorEdicion = null;
        _editandoId = mov.Id;
        _editForm.CategoriaId = mov.CategoriaId;
        _editForm.Monto = mov.Monto;
        _editForm.Nota = mov.Nota;
        // Se conserva la tarjeta: editar la categoría de una compra no debería
        // borrar sin avisar el vínculo con la tarjeta y descuadrar su saldo.
        _editForm.TarjetaCreditoId = mov.TarjetaCreditoId;
    }

    private void CancelarEdicion()
    {
        _editandoId = null;
        _errorEdicion = null;
    }

    private async Task GuardarEdicion()
    {
        if (_editandoId is null) return;
        _errorEdicion = null;
        _guardandoEdicion = true;

        var resultado = await Api.ActualizarMovimientoDiaADiaAsync(_editandoId.Value,
            new ActualizarMovimientoDiaADiaRequest(
                _editForm.CategoriaId, _editForm.Monto ?? 0, null, _editForm.Nota, _editForm.TarjetaCreditoId));

        if (resultado.Exito)
        {
            _editandoId = null;
            _saldoAcumulado = await Api.ObtenerResumenDiaADiaAsync();
            await CargarMesAsync();
        }
        else
        {
            _errorEdicion = resultado.TodosLosErrores();
        }

        _guardandoEdicion = false;
    }


    private string DonutGradient()
    {
        if (_resumen is null || _resumen.TotalGastos <= 0) return "var(--color-surface-2)";

        var partes = new List<string>();
        decimal acumulado = 0;
        for (var i = 0; i < _resumen.GastosPorCategoria.Count; i++)
        {
            var cat = _resumen.GastosPorCategoria[i];
            var color = Paleta[i % Paleta.Length];
            var inicio = acumulado / _resumen.TotalGastos * 360;
            acumulado += cat.Total;
            var fin = acumulado / _resumen.TotalGastos * 360;
            partes.Add($"{color} {inicio:0.##}deg {fin:0.##}deg");
        }
        return $"conic-gradient({string.Join(", ", partes)})";
    }

    private static string NombreMes(DateTime fecha)
    {
        string[] meses = ["enero", "febrero", "marzo", "abril", "mayo", "junio", "julio", "agosto", "septiembre", "octubre", "noviembre", "diciembre"];
        return $"{meses[fecha.Month - 1]} {fecha.Year}";
    }

    private static string NombreDia(DateTime fecha)
    {
        string[] dias = ["domingo", "lunes", "martes", "miércoles", "jueves", "viernes", "sábado"];
        string[] meses = ["ene", "feb", "mar", "abr", "may", "jun", "jul", "ago", "sep", "oct", "nov", "dic"];
        var hoy = DateTime.UtcNow.ToLocalTime().Date;
        if (fecha == hoy) return "Hoy";
        if (fecha == hoy.AddDays(-1)) return "Ayer";
        return $"{dias[(int)fecha.DayOfWeek]} {fecha.Day} {meses[fecha.Month - 1]}";
    }

    private class FormModel
    {
        public TipoCategoria Tipo { get; set; } = TipoCategoria.Gasto;
        public int CategoriaId { get; set; }
        public decimal Monto { get; set; }
        public string? Nota { get; set; }
        public int? TarjetaCreditoId { get; set; }
    }
