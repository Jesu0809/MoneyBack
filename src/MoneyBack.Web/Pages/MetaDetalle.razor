@page "/metas/{MetaId:int}"
@attribute [Authorize]
@inject ApiClient Api
@inject NavigationManager Nav

<PageTitle>@(_meta?.Nombre ?? "Meta") · MoneyBack</PageTitle>

@if (_cargando)
{
    <div class="stack">
        <Esqueleto Forma="resumen" />
        <Esqueleto Filas="3" />
    </div>
}
else if (_meta is null)
{
    <Vacio Icono="alert-triangle" Titulo="No encontramos esta meta"
           Detalle="Puede que la hayan borrado, o que sea de un grupo del que ya no haces parte.">
        <ContenidoExtra>
            <a class="btn btn-secondary" href="/hogar">Volver a los grupos</a>
        </ContenidoExtra>
    </Vacio>
}
else
{
    <div class="stack">
        <div class="row">
            <button class="btn-ghost btn" @onclick='() => Nav.NavigateTo("/hogar")'><Icon Name="chevron-left" Size="18" /> Hogar</button>
        </div>

        <div class="card">
            <div class="stack">
                <div class="row-between">
                    <div>
                        <div class="label">@_meta.Icono @(_meta.EsFondoEmergencia ? "Fondo de emergencia" : "Meta de ahorro")</div>
                        <h2>@_meta.Nombre</h2>
                    </div>
                    @if (!_meta.Activa)
                    {
                        <span class="pill pill-warning">Archivada</span>
                    }
                </div>

                <AnilloProgreso Porcentaje="_meta.PorcentajeCompletado" Leyenda="del total" />

                <div class="row-between">
                    <div>
                        <div class="label">Llevan</div>
                        <AnimatedMoney Valor="_meta.MontoActual" Class="money money-md" />
                    </div>
                    <div style="text-align:right">
                        <div class="label">Meta</div>
                        <span class="money money-md">@Formato.Pesos(_meta.MontoObjetivo)</span>
                    </div>
                </div>

                @* Lo que de verdad se quiere saber de una meta a años vista
                   no es el porcentaje: es si a este ritmo se llega. *@
                @if (Ritmo() is { } ritmo)
                {
                    <div class="divider"></div>
                    <div class="row" style="gap:8px; align-items:flex-start">
                        <Icon Name="coin" Size="16" />
                        <span style="font-size:13.5px">@ritmo</span>
                    </div>
                }
            </div>
        </div>

        @if (_meta.AportesPorUsuario.Count > 0)
        {
            <div class="card">
                <div class="stack">
                    <div class="label">Quién ha aportado</div>
                    @foreach (var aporte in _meta.AportesPorUsuario)
                    {
                        <div class="row-between">
                            <span>@aporte.UsuarioNombre</span>
                            <span class="money money-md">@Formato.Pesos(aporte.TotalAportado)</span>
                        </div>
                    }
                </div>
            </div>
        }

        @if (_meta.Activa)
        {
            <div class="card">
                @if (!_mostrarFormMovimiento)
                {
                    <button class="btn btn-primary btn-block" @onclick="() => _mostrarFormMovimiento = true">
                        <Icon Name="plus" Size="18" /> Registrar aporte o retiro
                    </button>
                }
                else
                {
                    <EditForm Model="_movForm" OnValidSubmit="RegistrarMovimiento">
                        <div class="stack">
                            <div class="field">
                                <label>Tipo</label>
                                <InputSelect class="input" @bind-Value="_movForm.Tipo">
                                    <option value="@TipoMovimiento.Aporte">Aporte</option>
                                    <option value="@TipoMovimiento.Retiro">Retiro</option>
                                </InputSelect>
                            </div>
                            <div class="field">
                                <label>Monto</label>
                                <InputNumber class="input" @bind-Value="_movForm.Monto" placeholder="500000" />
                            </div>
                            <div class="field">
                                <label>Nota (opcional)</label>
                                <InputText class="input" @bind-Value="_movForm.Nota" placeholder="Aporte de septiembre" />
                            </div>

                            <AlertBox Mensaje="@_error" />

                            <div class="row">
                                <button class="btn btn-secondary" type="button" @onclick="CancelarMovimiento">Cancelar</button>
                                <button class="btn btn-primary" style="flex:1" type="submit" disabled="@_guardando">
                                    @if (_guardando) { <span class="spinner"></span> }
                                    <span>Guardar</span>
                                </button>
                            </div>
                        </div>
                    </EditForm>
                }
            </div>
        }

        <div class="card">
            <div class="stack">
                <div class="label">Historial</div>
                @if (_meta.Movimientos.Count == 0)
                {
                    <p class="muted">Todavía no hay movimientos.</p>
                }
                else
                {
                    @foreach (var mov in _meta.Movimientos)
                    {
                        var esAporte = mov.Tipo == TipoMovimiento.Aporte;
                        <div class="list-item">
                            <div class="row">
                                <div class="icon-bubble @(esAporte ? "icon-bubble-accent" : "icon-bubble-danger")">
                                    <Icon Name="@(esAporte ? "arrow-up" : "arrow-down")" Size="16" />
                                </div>
                                <div>
                                    <div style="font-weight:600">@mov.UsuarioNombre @(mov.EsAutomatico ? "· automático" : "")</div>
                                    <div class="muted">@Formato.FechaHora(mov.Fecha)@(string.IsNullOrEmpty(mov.Nota) ? "" : $" · {mov.Nota}")</div>
                                </div>
                            </div>
                            <span class="money money-md" style="color: @(esAporte ? "var(--color-accent-strong)" : "var(--color-danger)")">
                                @(esAporte ? "+" : "-")@Formato.Pesos(mov.Monto)
                            </span>
                        </div>
                    }
                }
            </div>
        </div>

        @if (_meta.Activa)
        {
            <button class="btn btn-secondary btn-block" @onclick="ArchivarMeta">Archivar meta</button>
        }
    </div>
}

@code {
    [Parameter] public int MetaId { get; set; }

    /// <summary>
    /// Permite llegar desde Día a día con el aporte pre-llenado (ver botón
    /// "Aportar a nuestra meta" en DiaADia.razor) — abre el formulario ya
    /// listo para confirmar en vez de que el usuario tenga que repetir el monto.
    /// </summary>
    [SupplyParameterFromQuery] public decimal? Monto { get; set; }

    private bool _cargando = true;
    private bool _guardando;
    private bool _mostrarFormMovimiento;
    private string? _error;
    private MetaDetalleResponse? _meta;
    private readonly MovFormModel _movForm = new();
    private bool _montoAplicado;

    protected override async Task OnParametersSetAsync()
    {
        await CargarAsync();

        if (!_montoAplicado && Monto is > 0)
        {
            _movForm.Monto = Monto;
            _mostrarFormMovimiento = true;
            _montoAplicado = true;
        }
    }

    private async Task CargarAsync()
    {
        _cargando = true;
        _meta = await Api.ObtenerMetaAsync(MetaId);
        _cargando = false;
    }

    /// <summary>
    /// A este ritmo, cuánto falta. Se calcula con lo aportado desde el
    /// primer movimiento, no con el promedio de los aportes: dos aportes
    /// grandes en un año no son el mismo ritmo que dos en un mes.
    ///
    /// Devuelve null cuando todavía no hay con qué decir nada honesto —
    /// menos de un mes de historia, o nada aportado. Una proyección hecha
    /// con un solo dato no es una proyección, es un número inventado, y
    /// acá se usa para decidir sobre una compra de cien millones.
    /// </summary>
    private string? Ritmo()
    {
        if (_meta is null || !_meta.Activa) return null;

        var aportes = _meta.Movimientos.Where(m => m.Tipo == TipoMovimiento.Aporte).ToList();
        if (aportes.Count < 2) return null;

        var desde = aportes.Min(m => m.Fecha);
        var meses = (decimal)(DateTime.UtcNow - desde).TotalDays / 30.44m;
        if (meses < 1) return null;

        var porMes = _meta.MontoActual / meses;
        if (porMes <= 0) return null;

        var falta = _meta.MontoObjetivo - _meta.MontoActual;
        if (falta <= 0) return "Ya llegaron a la meta. 🎉";

        var mesesQueFaltan = (int)Math.Ceiling(falta / porMes);

        var cuanto = mesesQueFaltan switch
        {
            1 => "un mes",
            < 12 => $"{mesesQueFaltan} meses",
            < 24 => "algo más de un año",
            _ => $"unos {mesesQueFaltan / 12} años"
        };

        return $"Van a {Formato.Pesos(porMes)} por mes. A ese ritmo faltan {cuanto}.";
    }

    private void CancelarMovimiento()
    {
        _mostrarFormMovimiento = false;
        _error = null;
        _movForm.Monto = null;
        _movForm.Nota = "";
    }

    private async Task RegistrarMovimiento()
    {
        _error = null;
        _guardando = true;

        var resultado = await Api.RegistrarMovimientoAsync(MetaId,
            new CrearMovimientoRequest(_movForm.Tipo, _movForm.Monto ?? 0, _movForm.Nota));

        if (resultado.Exito)
        {
            _mostrarFormMovimiento = false;
            _movForm.Monto = null;
            _movForm.Nota = "";
            await CargarAsync();
        }
        else
        {
            _error = resultado.TodosLosErrores();
        }

        _guardando = false;
    }

    private async Task ArchivarMeta()
    {
        await Api.ArchivarMetaAsync(MetaId);
        await CargarAsync();
    }

    private class MovFormModel
    {
        public TipoMovimiento Tipo { get; set; } = TipoMovimiento.Aporte;
        public decimal? Monto { get; set; }
        public string? Nota { get; set; }
    }
}
