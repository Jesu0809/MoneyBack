@page "/vuelto"
@attribute [Authorize]
@inject ApiClient Api
@inject NavigationManager Nav

<PageTitle>Ahorrar con el vuelto · MoneyBack</PageTitle>

@*
    Esto vivía dentro de Hogar, y ahí estorbaba: esa pantalla es el ahorro
    compartido —cuánto llevan, para qué— y el vuelto es un ajuste sobre cómo
    se gasta. Son dos cabezas distintas.
*@

<div class="stack">
    <div class="row">
        <button class="btn-ghost btn" @onclick='() => Nav.NavigateTo("/mas")'><Icon Name="chevron-left" Size="18" /> Más</button>
    </div>

    <div>
        <h2>Ahorrar con el vuelto</h2>
        <p class="muted">Cada gasto se redondea al siguiente $1.000 y la diferencia se ahorra sola.</p>
    </div>

    @if (_cargando)
    {
        <div class="center-screen"><div class="spinner spinner-accent"></div></div>
    }
    else if (_hogar is null)
    {
        <div class="card">
            <p class="muted">Necesitas un hogar para esto: el vuelto va a las metas compartidas. Créalo en <a href="/hogar">Hogar</a>.</p>
        </div>
    }
    else
    {
        <div class="card">
            <div class="stack">
                <div class="switch-row">
                    <div>
                        <div style="font-weight:600">Redondear mis gastos</div>
                        <div class="muted">Aplica a los gastos de los dos.</div>
                    </div>
                    <button type="button" class="switch @(_hogar.RedondeoActivo ? "on" : "")"
                            @onclick="Alternar" disabled="@_guardando">
                        <div class="knob"></div>
                    </button>
                </div>

                <div class="divider"></div>

                <div class="stack" style="gap:4px">
                    <span class="label">Cómo funciona</span>
                    <div class="row-between"><span class="muted">Compras un almuerzo de</span><span>$13.500</span></div>
                    <div class="row-between"><span class="muted">Se redondea a</span><span>$14.000</span></div>
                    <div class="row-between">
                        <span style="font-weight:600">Se ahorran</span>
                        <span class="money" style="color:var(--color-accent-strong)">$500</span>
                    </div>
                    <span class="muted" style="font-size:12.5px; margin-top:4px">
                        Nunca más de $999 por gasto, pero con treinta compras al mes suma sin que lo sientas.
                        Si el gasto ya termina en $000, no aporta nada.
                    </span>
                </div>
            </div>
        </div>

        @if (_total > 0)
        {
            <div class="hero-balance">
                <div class="stack" style="gap:8px">
                    <span class="label">Llevan ahorrado así</span>
                    <AnimatedMoney Valor="_total" Class="money money-lg" />
                    <span class="muted" style="font-size:12.5px">Sin haberlo decidido ni una sola vez.</span>
                </div>
            </div>
        }

        @if (_metas.Count > 0)
        {
            <div class="card">
                <div class="stack">
                    <div class="label">A dónde va</div>
                    @* Se ajusta acá y no al crear la meta: allá la pregunta
                       aparecía sin contexto y se leía como un monto —alguien
                       escribió 55.000 en un campo de porcentaje. Acá se está
                       mirando el vuelto, así que se entiende sola. *@
                    @foreach (var meta in _metas)
                    {
                        <div class="row-between" style="padding:6px 0; gap:12px">
                            <span style="min-width:0">@meta.Icono @meta.Nombre</span>
                            <div class="row" style="gap:6px; align-items:center">
                                <input class="input" type="number" min="0" max="100" inputmode="numeric"
                                       style="width:76px; text-align:right"
                                       value="@meta.PorcentajeRedondeo"
                                       @onchange="e => CambiarPorcentaje(meta, e.Value?.ToString())" />
                                <span class="muted">%</span>
                            </div>
                        </div>
                    }

                    @if (_guardandoReparto)
                    {
                        <span class="muted" style="font-size:12.5px">Guardando…</span>
                    }
                    else
                    {
                        <span class="muted" style="font-size:12.5px">
                            No tiene que sumar 100: lo que pongas se reparte proporcional.
                            En 0, esa meta solo recibe lo que le aportes a mano.
                        </span>
                    }
                </div>
            </div>
        }
    }
</div>

@code {
    private bool _cargando = true;
    private bool _guardando;
    private HogarResponse? _hogar;
    private decimal _total;
    private List<MetaResponse> _metas = [];

    protected override async Task OnInitializedAsync()
    {
        _hogar = await Api.ObtenerMiHogarAsync();

        if (_hogar is not null)
        {
            _total = await Api.ObtenerTotalRedondeoAsync();
            _metas = (await Api.ObtenerMetasAsync(_hogar.Id)).Where(m => m.Activa).ToList();
        }

        _cargando = false;
    }

    private bool _guardandoReparto;

    /// <summary>
    /// Guarda apenas se cambia, sin botón. Un "guardar" aparte para un
    /// número suelto es un paso extra que la gente olvida, y el cambio se
    /// pierde sin que nadie se entere.
    /// </summary>
    private async Task CambiarPorcentaje(MetaResponse meta, string? valor)
    {
        if (!decimal.TryParse(valor, out var porcentaje)) return;

        porcentaje = Math.Clamp(porcentaje, 0, 100);
        _guardandoReparto = true;

        var resultado = await Api.ActualizarMetaAsync(meta.Id,
            new ActualizarMetaRequest(meta.Nombre, meta.MontoObjetivo, meta.Icono, porcentaje));

        if (resultado.Exito && _hogar is not null)
        {
            _metas = (await Api.ObtenerMetasAsync(_hogar.Id)).Where(m => m.Activa).ToList();
        }

        _guardandoReparto = false;
    }

    private async Task Alternar()
    {
        if (_hogar is null) return;
        _guardando = true;

        var resultado = await Api.ActualizarHogarAsync(
            new ActualizarHogarRequest(_hogar.AplicaTope150, !_hogar.RedondeoActivo));

        if (resultado.Exito) _hogar = resultado.Valor;
        _guardando = false;
    }
}
