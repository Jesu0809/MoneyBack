@page "/tarjetas-credito"
@attribute [Authorize]
@inject ApiClient Api
@inject NavigationManager Nav

<PageTitle>Tarjetas de crédito · MoneyBack</PageTitle>

<div class="stack">
    <div class="row">
        <button class="btn-ghost btn" @onclick='() => Nav.NavigateTo("/mas")'><Icon Name="chevron-left" Size="18" /> Más</button>
    </div>

    <div>
        <h2>Tarjetas de crédito</h2>
        <p class="muted">Tus compras con tarjeta ya se registran como gasto normal en tu día a día. Aquí solo llevas la cuenta de cuánto le debes al banco — pagarla no vuelve a restar tu saldo, porque ya se restó cuando compraste.</p>
    </div>

    @if (_cargando)
    {
        <div class="center-screen"><div class="spinner spinner-accent"></div></div>
    }
    else
    {
        <div class="card">
            @if (!_mostrarForm)
            {
                <button class="btn btn-primary btn-block" @onclick="AbrirFormNueva"><Icon Name="plus" Size="18" /> Nueva tarjeta</button>
            }
            else
            {
                <EditForm Model="_form" OnValidSubmit="Guardar">
                    <div class="stack">
                        <div class="field">
                            <label>Nombre</label>
                            <InputText class="input" @bind-Value="_form.Nombre" placeholder="Visa Bancolombia" />
                        </div>
                        <div class="field">
                            <label>Día del mes en que cierra (opcional saberlo exacto)</label>
                            <InputNumber class="input" @bind-Value="_form.DiaCorte" placeholder="20" />
                        </div>
                        <AlertBox Mensaje="@_error" />
                        <div class="row">
                            <button class="btn btn-secondary" type="button" @onclick="() => _mostrarForm = false">Cancelar</button>
                            <button class="btn btn-primary" style="flex:1" type="submit" disabled="@_guardando">
                                @if (_guardando) { <span class="spinner"></span> }
                                <span>Guardar</span>
                            </button>
                        </div>
                    </div>
                </EditForm>
            }
        </div>

        @if (_tarjetas.Count == 0)
        {
            <div class="empty-state">
                <p>No tienes tarjetas de crédito registradas.</p>
            </div>
        }
        else
        {
            @foreach (var t in _tarjetas)
            {
                var saldo = _saldos.GetValueOrDefault(t.Id);
                <div class="card">
                    <div class="stack">
                        <div class="row-between">
                            <div>
                                <div class="label">Cierra el @t.DiaCorte de cada mes</div>
                                <h3>@t.Nombre</h3>
                            </div>
                            <button class="icon-btn" style="width:30px;height:30px;background:transparent;border:none" @onclick="() => Eliminar(t.Id)">
                                <Icon Name="trash" Size="15" />
                            </button>
                        </div>

                        <div class="row-between">
                            <span class="muted" style="font-size:13px">Saldo pendiente</span>
                            <span class="money money-md" style="color: @(saldo is { Monto: > 0 } ? "var(--color-danger)" : "var(--color-accent-strong)")">
                                @Formato.Pesos(saldo?.Monto ?? 0)
                            </span>
                        </div>
                        @if (saldo?.UltimoPago is not null)
                        {
                            <div class="muted" style="font-size:12px">Último pago: @Formato.FechaCorta(saldo.UltimoPago.Value)</div>
                        }

                        @if (_tarjetaPagando == t.Id)
                        {
                            <div class="divider"></div>
                            <div class="stack" style="gap:10px">
                                <div class="field" style="margin:0">
                                    <label>¿Cuánto le pagaste al banco?</label>
                                    <InputNumber class="input" @bind-Value="_pagoForm.Monto" placeholder="@((saldo?.Monto ?? 0).ToString("0"))" />
                                </div>
                                <AlertBox Mensaje="@_errorPago" />
                                <div class="row" style="gap:8px">
                                    <button class="btn btn-secondary" style="flex:1" @onclick="() => _tarjetaPagando = null">Cancelar</button>
                                    <button class="btn btn-primary" style="flex:1" disabled="@_pagando" @onclick="() => RegistrarPago(t.Id)">
                                        @if (_pagando) { <span class="spinner"></span> }
                                        <span>Confirmar pago</span>
                                    </button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <button class="btn btn-secondary btn-block" @onclick="() => AbrirFormPago(t.Id, saldo?.Monto ?? 0)">Registrar pago</button>
                        }
                    </div>
                </div>
            }
        }
    }
</div>

@code {
    private bool _cargando = true;
    private bool _guardando;
    private bool _pagando;
    private bool _mostrarForm;
    private int? _tarjetaPagando;
    private string? _error;
    private string? _errorPago;
    private List<TarjetaCreditoResponse> _tarjetas = [];
    private readonly Dictionary<int, SaldoPendienteResponse> _saldos = [];
    private readonly FormModel _form = new();
    private readonly PagoFormModel _pagoForm = new();

    protected override async Task OnInitializedAsync()
    {
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        _cargando = true;
        _tarjetas = await Api.ObtenerTarjetasCreditoAsync();
        _saldos.Clear();
        foreach (var t in _tarjetas)
        {
            var saldo = await Api.ObtenerSaldoPendienteTarjetaAsync(t.Id);
            if (saldo is not null) _saldos[t.Id] = saldo;
        }
        _cargando = false;
    }

    private void AbrirFormNueva()
    {
        _error = null;
        _form.Nombre = "";
        _form.DiaCorte = null;
        _mostrarForm = true;
    }

    private void AbrirFormPago(int tarjetaId, decimal saldoActual)
    {
        _errorPago = null;
        _pagoForm.Monto = saldoActual > 0 ? saldoActual : null;
        _tarjetaPagando = tarjetaId;
    }

    private async Task Guardar()
    {
        _error = null;
        _guardando = true;

        var resultado = await Api.CrearTarjetaCreditoAsync(new CrearTarjetaCreditoRequest(_form.Nombre, _form.DiaCorte ?? 1));

        if (resultado.Exito)
        {
            _mostrarForm = false;
            await CargarAsync();
        }
        else
        {
            _error = resultado.TodosLosErrores();
        }

        _guardando = false;
    }

    private async Task RegistrarPago(int tarjetaId)
    {
        _errorPago = null;
        _pagando = true;

        var resultado = await Api.RegistrarPagoTarjetaAsync(tarjetaId, new RegistrarPagoTarjetaRequest(_pagoForm.Monto ?? 0));

        if (resultado.Exito)
        {
            _tarjetaPagando = null;
            await CargarAsync();
        }
        else
        {
            _errorPago = resultado.TodosLosErrores();
        }

        _pagando = false;
    }

    private async Task Eliminar(int id)
    {
        await Api.EliminarTarjetaCreditoAsync(id);
        await CargarAsync();
    }

    private class FormModel
    {
        public string Nombre { get; set; } = "";
        public int? DiaCorte { get; set; }
    }

    private class PagoFormModel
    {
        public decimal? Monto { get; set; }
    }
}
