@page "/admin"
@attribute [Authorize(Roles = "SuperAdmin")]
@inject ApiClient Api
@inject ConfirmacionService Confirmacion
@inject AuthenticationStateProvider AuthProvider

<PageTitle>Admin · MoneyBack</PageTitle>

<div class="stack">
    <div>
        <h2>Administración</h2>
        <p class="muted">Solo gestión de cuentas — nunca vemos las metas ni movimientos de ningún hogar desde aquí.</p>
    </div>

    <div class="card">
        <div class="stack">
            <div class="label">Rotar código de invitación</div>
            <p class="muted">El código actual deja de servir apenas generes uno nuevo.</p>
            <EditForm Model="_codigoForm" OnValidSubmit="RotarCodigo">
                <div class="row">
                    <InputText class="input" @bind-Value="_codigoForm.NuevoCodigo" placeholder="Nuevo código (mín. 8 caracteres)" />
                    <button class="btn btn-primary" type="submit" disabled="@_rotando">
                        @if (_rotando) { <span class="spinner"></span> } else { <span>Rotar</span> }
                    </button>
                </div>
            </EditForm>
            <AlertBox Mensaje="@_errorCodigo" />
            @if (_codigoRotado)
            {
                <AlertBox Tipo="accent" Mensaje="@($"Código activo ahora: \"{_ultimoCodigoActivo}\" — compártelo tal cual, sin espacios ni mayúsculas de más.")" />
            }
        </div>
    </div>

    <div class="card">
        <div class="stack">
            <div class="label">Cuentas registradas</div>
            @if (_cargando)
            {
                <Esqueleto Filas="2" />
            }
            else
            {
                @foreach (var usuario in _usuarios)
                {
                    <div class="list-item">
                        <div>
                            <div style="font-weight:600">
                                @usuario.Nombre
                                @if (usuario.Roles.Count > 0)
                                {
                                    <span class="pill" style="margin-left:6px">@string.Join(", ", usuario.Roles)</span>
                                }
                                @if (usuario.Id == _miUsuarioId)
                                {
                                    <span class="pill" style="margin-left:6px">esta es la tuya</span>
                                }
                            </div>
                            <div class="muted">@usuario.Email · desde @Formato.FechaCorta(usuario.FechaCreacion)</div>
                        </div>
                        <div class="row" style="gap:6px">
                            <button class="btn btn-secondary" @onclick="() => RevocarSesiones(usuario.Id)" disabled="@(_revocandoId == usuario.Id)">
                                @if (_revocandoId == usuario.Id) { <span class="spinner"></span> } else { <span>Cerrar sesiones</span> }
                            </button>
                            <button class="btn btn-secondary" @onclick="() => CambiarClave(usuario)" disabled="@(_cambiandoClaveId == usuario.Id)">
                                @if (_cambiandoClaveId == usuario.Id) { <span class="spinner"></span> } else { <span>Cambiar clave</span> }
                            </button>
                        </div>
                    </div>

                    @if (_claveGenerada is not null && _claveGeneradaPara == usuario.Id)
                    {
                        @* Se muestra acá y una sola vez: al recargar la página
                           se pierde, porque el servidor solo guarda el hash y
                           no hay forma de volver a pedirla. *@
                        <div class="card" style="border-left:3px solid var(--color-warning)">
                            <div class="stack" style="gap:8px">
                                <div class="row" style="gap:8px">
                                    <Icon Name="alert-triangle" Size="17" />
                                    <strong>Anótala ahora: no se puede volver a ver</strong>
                                </div>
                                <div class="money" style="font-size:26px; letter-spacing:0.04em; user-select:all">
                                    @_claveGenerada
                                </div>
                                <p class="muted" style="margin:0; font-size:13px">
                                    @if (usuario.Id == _miUsuarioId)
                                    {
                                        <text>Anótala: tu sesión ya se cerró y la vas a necesitar para volver a entrar.</text>
                                    }
                                    else
                                    {
                                        <text>Pásasela a @usuario.Nombre para que entre y se ponga la suya desde Perfil.</text>
                                    }
                                    @if (_sesionesCerradas > 0)
                                    {
                                        <text>Se cerraron @_sesionesCerradas sesión(es) que tenía abiertas.</text>
                                    }
                                </p>
                            </div>
                        </div>
                    }
                }
            }
        </div>
    </div>

    @if (_mensajeRevocacion is not null)
    {
        <AlertBox Tipo="accent" Mensaje="@_mensajeRevocacion" />
    }
    <AlertBox Mensaje="@_errorClave" />
</div>

@code {
    private bool _cargando = true;
    private bool _rotando;
    private bool _codigoRotado;
    private string? _ultimoCodigoActivo;
    private string? _errorCodigo;
    private string? _mensajeRevocacion;
    private int? _revocandoId;
    private int? _miUsuarioId;
    private int? _cambiandoClaveId;
    private string? _claveGenerada;
    private int? _claveGeneradaPara;
    private int _sesionesCerradas;
    private string? _errorClave;
    private List<UsuarioAdminResponse> _usuarios = [];
    private readonly CodigoFormModel _codigoForm = new();

    protected override async Task OnInitializedAsync()
    {
        var estado = await AuthProvider.GetAuthenticationStateAsync();
        // El id viene en el claim "sub" del token, tal cual lo escribe el API.
        _miUsuarioId = int.TryParse(estado.User.FindFirst("sub")?.Value, out var id) ? id : null;

        _usuarios = await Api.ObtenerUsuariosAdminAsync();
        _cargando = false;
    }

    private async Task RotarCodigo()
    {
        _errorCodigo = null;
        _codigoRotado = false;
        _rotando = true;

        var codigoIngresado = _codigoForm.NuevoCodigo.Trim();
        var resultado = await Api.RotarCodigoInvitacionAsync(new RotarCodigoInvitacionRequest(codigoIngresado));

        if (resultado.Exito)
        {
            _codigoRotado = true;
            _ultimoCodigoActivo = codigoIngresado;
            _codigoForm.NuevoCodigo = "";
        }
        else
        {
            _errorCodigo = resultado.TodosLosErrores();
        }

        _rotando = false;
    }

    /// <summary>
    /// La contraseña anterior no se puede "ver": el servidor solo guarda su
    /// hash, así que lo único posible es reemplazarla. Se genera una
    /// temporal, se muestra una sola vez y la persona se pone la suya
    /// después.
    /// </summary>
    private async Task CambiarClave(UsuarioAdminResponse usuario)
    {
        // Cambiarse la clave a uno mismo cierra la propia sesión: si nadie
        // avisa, uno confirma, se sale la app y la clave nueva quedó en una
        // pantalla que ya no existe. En la única cuenta con Admin eso es
        // quedarse afuera sin nadie que abra.
        var esMiCuenta = usuario.Id == _miUsuarioId;

        var confirmado = await Confirmacion.PreguntarAsync(new Confirmacion(
            esMiCuenta ? "¿Cambiarte la contraseña a ti mismo?" : $"¿Cambiarle la contraseña a {usuario.Nombre}?",
            esMiCuenta
                ? "Se cierra tu sesión y tendrás que volver a entrar con la clave nueva. Se muestra una sola vez: "
                  + "anótala antes de cerrar la pantalla, porque si la pierdes nadie puede recuperarla por ti."
                : $"Se le pone una clave temporal y se cierran sus sesiones. La que tenía deja de servir, "
                  + $"y {usuario.Nombre} no podrá entrar hasta que le pases la nueva. Sus códigos de recuperación también se borran.",
            "Sí, cambiarla"));
        if (!confirmado) return;

        _cambiandoClaveId = usuario.Id;
        _claveGenerada = null;
        _errorClave = null;

        var resultado = await Api.GenerarClaveTemporalAsync(usuario.Id);

        if (resultado.Exito)
        {
            _claveGenerada = resultado.Valor!.Clave;
            _claveGeneradaPara = usuario.Id;
            _sesionesCerradas = resultado.Valor.SesionesCerradas;
        }
        else
        {
            _errorClave = resultado.TodosLosErrores();
        }

        _cambiandoClaveId = null;
    }

    private async Task RevocarSesiones(int usuarioId)
    {
        _revocandoId = usuarioId;
        _mensajeRevocacion = null;
        var cantidad = await Api.RevocarSesionesAsync(usuarioId);
        _mensajeRevocacion = cantidad > 0
            ? $"Se cerraron {cantidad} sesión(es) activa(s)."
            : "Esa cuenta no tenía sesiones activas.";
        _revocandoId = null;
    }

    private class CodigoFormModel
    {
        public string NuevoCodigo { get; set; } = "";
    }
}
