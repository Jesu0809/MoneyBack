@page "/hogar"
@attribute [Authorize]
@inject ApiClient Api
@inject NavigationManager Nav

<PageTitle>MoneyBack</PageTitle>

@if (_cargando)
{
    <div class="center-screen"><div class="spinner spinner-accent"></div></div>
}
else if (_hogar is not null)
{
    <div class="stack">
        @* Con varios grupos hace falta saber en cuál estás parado y poder
           cambiar sin ir a buscarlo a otra pantalla. Con uno solo, el
           selector no aparece: sería una decisión inventada. *@
        <div class="row-between">
            <div style="min-width:0">
                <h2>@_hogar.Nombre</h2>
                <p class="muted">@string.Join(" · ", _hogar.Miembros.Select(m => m.Nombre))</p>
            </div>
            <button class="icon-btn glass" @onclick="() => _mostrandoGrupos = !_mostrandoGrupos" title="Mis grupos">
                <Icon Name="@(_mostrandoGrupos ? "x" : "user")" Size="18" />
            </button>
        </div>

        @if (_mostrandoGrupos)
        {
            <div class="card">
                <div class="stack">
                    <div class="label">Mis grupos</div>
                    @foreach (var grupo in _misGrupos)
                    {
                        <div class="row-between card-tap" style="padding:8px 0" @onclick="() => CambiarGrupo(grupo.Id)">
                            <div>
                                <div style="font-weight:600">@grupo.Nombre</div>
                                <div class="muted" style="font-size:12.5px">
                                    @grupo.Miembros.Count @(grupo.Miembros.Count == 1 ? "persona" : "personas")
                                </div>
                            </div>
                            @if (grupo.Id == _hogar.Id)
                            {
                                <span class="pill">Viendo</span>
                            }
                            else
                            {
                                <Icon Name="chevron-right" Size="18" />
                            }
                        </div>
                    }

                    <div class="divider"></div>

                    @* Quién está adentro y cómo sumar a alguien. Estaba
                       resuelto en el API pero no había dónde hacerlo: la
                       única forma de invitar era la pantalla que sale cuando
                       NO tienes grupo, o sea nunca más. *@
                    <div class="label">Quiénes están en @_hogar.Nombre</div>
                    @foreach (var miembro in _hogar.Miembros)
                    {
                        <div class="row-between" style="padding:5px 0">
                            <span>@miembro.Nombre</span>
                            @if (miembro.EsAdministrador)
                            {
                                <span class="muted" style="font-size:12px">lo administra</span>
                            }
                        </div>
                    }

                    @if (_invitando)
                    {
                        <EditForm Model="_crearHogarForm" OnValidSubmit="EnviarInvitacion">
                            <div class="stack">
                                <div class="field">
                                    <label>Correo de quien quieres sumar</label>
                                    <InputText class="input" @bind-Value="_crearHogarForm.EmailPareja" placeholder="correo@ejemplo.com" />
                                    <span class="muted">Tiene que estar registrada y aceptar la invitación.</span>
                                </div>
                                <AlertBox Mensaje="@_error" />
                                <div class="row" style="gap:10px">
                                    <button type="button" class="btn btn-secondary" @onclick="() => _invitando = false">Cancelar</button>
                                    <button class="btn btn-primary btn-block" type="submit" disabled="@_guardando">
                                        @if (_guardando) { <span class="spinner"></span> }
                                        <span>Invitar</span>
                                    </button>
                                </div>
                            </div>
                        </EditForm>
                    }
                    else if (_invitacionEnviada is not null)
                    {
                        <AlertBox Tipo="accent" Mensaje="@($"Le escribimos a {_invitacionEnviada.InvitadoNombre}. Entra al grupo en cuanto acepte.")" />
                    }
                    else
                    {
                        <button class="btn btn-secondary btn-block" @onclick="() => _invitando = true">
                            <Icon Name="plus" Size="17" /> Sumar a alguien
                        </button>
                    }

                    <div class="divider"></div>

                    @if (_creandoGrupo)
                    {
                        <EditForm Model="_crearHogarForm" OnValidSubmit="CrearGrupo">
                            <div class="stack">
                                <div class="field">
                                    <label>¿Cómo se llama el grupo nuevo?</label>
                                    <InputText class="input" @bind-Value="_crearHogarForm.Nombre" placeholder="Nombre del grupo" />
                                </div>
                                <AlertBox Mensaje="@_error" />
                                <div class="row" style="gap:10px">
                                    <button type="button" class="btn btn-secondary" @onclick="() => _creandoGrupo = false">Cancelar</button>
                                    <button class="btn btn-primary btn-block" type="submit" disabled="@_guardando">
                                        @if (_guardando) { <span class="spinner"></span> }
                                        <span>Crear</span>
                                    </button>
                                </div>
                            </div>
                        </EditForm>
                    }
                    else
                    {
                        <button class="btn btn-secondary btn-block" @onclick="() => _creandoGrupo = true">
                            <Icon Name="plus" Size="17" /> Crear otro grupo
                        </button>
                    }
                </div>
            </div>
        }

        @if (_metas.Count > 0)
        {
            <div class="hero-balance">
                <div class="stack" style="gap:10px">
                    <span class="label">Ahorro total</span>
                    <AnimatedMoney Valor="_metas.Sum(m => m.MontoActual)" Class="money money-lg" />
                    <div class="divider"></div>
                    <div class="row-between">
                        <span class="muted">Meta combinada</span>
                        <span style="font-weight:650">@Formato.Pesos(_metas.Sum(m => m.MontoObjetivo))</span>
                    </div>
                </div>
            </div>
        }

        @if (_aportesPorUsuario.Count > 0)
        {
            <div class="card">
                <div class="stack">
                    <div class="label">Quién ha aportado</div>
                    @foreach (var aporte in _aportesPorUsuario)
                    {
                        <div class="row-between">
                            <span>@aporte.UsuarioNombre</span>
                            <span class="money money-md">@Formato.Pesos(aporte.TotalAportado)</span>
                        </div>
                    }
                </div>
            </div>
        }

        @foreach (var meta in _metas.Where(m => m.Activa))
        {
            <div class="card card-tap" @onclick="() => IrAMeta(meta.Id)">
                <div class="stack">
                    <div class="row-between">
                        <div class="row">
                            <div class="icon-bubble icon-bubble-accent" style="font-size:19px">@meta.Icono</div>
                            <div>
                                <div class="label">
                                    @if (meta.EsFondoEmergencia) { <text>Fondo de emergencia · </text> }
                                    @(meta.PorcentajeRedondeo > 0 ? $"{meta.PorcentajeRedondeo:N0}% del vuelto" : "Solo aportes a mano")
                                </div>
                                <h3>@meta.Nombre</h3>
                            </div>
                        </div>
                        <span class="pill">@Formato.Porcentaje(meta.PorcentajeCompletado)</span>
                    </div>

                    <ProgressBar Porcentaje="meta.PorcentajeCompletado" />

                    <div class="row-between">
                        <AnimatedMoney Valor="meta.MontoActual" Class="money money-md" />
                        <span class="muted">de @Formato.Pesos(meta.MontoObjetivo)</span>
                    </div>
                </div>
            </div>
        }

        @if (_mostrandoFormNuevaMeta)
        {
                <div class="card">
                    <div class="stack">
                        <h3>@(_metas.Count == 0 ? "Crea tu primera meta" : "Agregar otra meta")</h3>
                        @if (_metas.Count == 0)
                        {
                            <p class="muted">Un apartamento, una lavadora, un viaje, el fondo de emergencia — lo que estén ahorrando.</p>
                        }
                        <EditForm Model="_crearMetaForm" OnValidSubmit="CrearMeta">
                            <div class="stack">
                                <div class="field">
                                    <label>¿Para qué están ahorrando?</label>
                                    @* Un <input> normal y no InputText: @bind-Value:event no existe
                                       para componentes y revienta al teclear. *@
                                    <input class="input" value="@_crearMetaForm.Nombre"
                                           @oninput="e => _crearMetaForm.Nombre = e.Value?.ToString() ?? string.Empty"
                                           placeholder="Para qué ahorran" />
                                </div>
                                <div class="field">
                                    <label>Ícono</label>
                                    <SelectorEmoji @bind-Valor="_crearMetaForm.Icono" Sugeridos="EmojisSugeridos.Para(_crearMetaForm.Nombre)" />
                                </div>
                                <div class="field">
                                    <label>Meta en pesos</label>
                                    <InputNumber class="input" @bind-Value="_crearMetaForm.MontoObjetivo" placeholder="Cuánto quieren juntar" />
                                </div>
                                <AlertBox Mensaje="@_error" />
                                <div class="row" style="gap:10px">
                                    @if (_metas.Count > 0)
                                    {
                                        <button type="button" class="btn btn-secondary" @onclick="() => _mostrandoFormNuevaMeta = false">Cancelar</button>
                                    }
                                    <button class="btn btn-primary btn-block" type="submit" disabled="@_guardando">
                                        @if (_guardando) { <span class="spinner"></span> }
                                        <span>Crear meta</span>
                                    </button>
                                </div>
                            </div>
                        </EditForm>
                    </div>
                </div>
            }
            else
            {
                var archivadas = _metas.Where(m => !m.Activa).ToList();
                if (archivadas.Count > 0)
                {
                    @* Antes una meta archivada desaparecía y no había forma de
                       traerla de vuelta, con su historial de aportes adentro.
                       Archivar sin poder deshacer es borrar con otro nombre. *@
                    <div class="card">
                        <div class="stack">
                            <div class="label">Archivadas</div>
                            @foreach (var meta in archivadas)
                            {
                                <div class="row-between" style="padding:5px 0">
                                    <div class="row" style="gap:10px">
                                        <span style="font-size:18px; opacity:0.6">@meta.Icono</span>
                                        <div>
                                            <div style="font-weight:600; font-size:14px">@meta.Nombre</div>
                                            <div class="muted" style="font-size:12px">@Formato.Pesos(meta.MontoActual) guardados</div>
                                        </div>
                                    </div>
                                    <button class="btn btn-ghost" disabled="@(_desarchivando == meta.Id)"
                                            @onclick="() => Desarchivar(meta.Id)">
                                        @if (_desarchivando == meta.Id) { <span class="spinner"></span> }
                                        else { <span style="font-size:13px">Recuperar</span> }
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                }

                <button type="button" class="card card-tap add-meta-card" @onclick="AbrirFormNuevaMeta">
                    <div class="icon-bubble icon-bubble-accent"><Icon Name="plus" Size="18" /></div>
                    <span>@(_metas.Count == 0 ? "Crear nuestra primera meta" : "Agregar otra meta")</span>
                </button>
            }
    </div>
}
else if (_invitacionRecibida is not null)
{
    <div class="stack">
        <h2>Tienes una invitación</h2>
        <div class="card">
            <div class="stack">
                <p>
                    <strong>@_invitacionRecibida.InvitadorNombre</strong> te invitó a crear un hogar en MoneyBack
                    para ahorrar juntos. Si aceptas, sus aportes de redondeo y tus metas quedan compartidos.
                </p>
                <AlertBox Mensaje="@_error" />
                <div class="row" style="gap:8px">
                    <button class="btn btn-secondary" style="flex:1" disabled="@_guardando" @onclick="RechazarInvitacion">Rechazar</button>
                    <button class="btn btn-primary" style="flex:1" disabled="@_guardando" @onclick="AceptarInvitacion">
                        @if (_guardando) { <span class="spinner"></span> }
                        <span>Aceptar</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
}
else if (_invitacionEnviada is not null)
{
    <div class="stack">
        <h2>Invitación enviada</h2>
        <div class="card">
            <div class="stack">
                <p>Le enviamos una invitación a <strong>@_invitacionEnviada.InvitadoNombre</strong>. En cuanto la acepte, verás el hogar acá.</p>
                <AlertBox Mensaje="@_error" />
                <button class="btn btn-secondary btn-block" disabled="@_guardando" @onclick="RechazarInvitacion">Cancelar invitación</button>
            </div>
        </div>
    </div>
}
else
{
    <div class="stack">
        <div>
            <h2>Empieza un grupo de ahorro</h2>
            <p class="muted">
                Con tu pareja, con tu familia, con quien sea. Puedes crearlo ahora y sumar gente después
                — no necesitas esperar a nadie para empezar.
            </p>
        </div>

        <div class="card">
            <EditForm Model="_crearHogarForm" OnValidSubmit="CrearGrupo">
                <div class="stack">
                    <div class="field">
                        <label>¿Cómo se llama?</label>
                        <InputText class="input" @bind-Value="_crearHogarForm.Nombre" placeholder="Nombre del grupo" />
                    </div>

                    <div class="switch-row">
                        <div>
                            <div style="font-weight:600">¿Buscan vivienda en Bogotá, Cali, Medellín, Barranquilla o Bucaramanga?</div>
                            <div class="muted">Cambia el tope VIS que aplica. Lo puedes cambiar después.</div>
                        </div>
                        <button type="button" class="switch @(_crearHogarForm.AplicaTope150 ? "on" : "")"
                                @onclick="() => _crearHogarForm.AplicaTope150 = !_crearHogarForm.AplicaTope150">
                            <div class="knob"></div>
                        </button>
                    </div>

                    <AlertBox Mensaje="@_error" />

                    <button class="btn btn-primary btn-block" type="submit" disabled="@_guardando">
                        @if (_guardando) { <span class="spinner"></span> }
                        <span>Crear grupo</span>
                    </button>
                </div>
            </EditForm>
        </div>
    </div>

@code {
    private bool _cargando = true;
    private bool _guardando;
    private bool _mostrandoFormNuevaMeta;
    private string? _error;
    private HogarResponse? _hogar;
    private List<HogarResponse> _misGrupos = [];
    private bool _mostrandoGrupos;
    private bool _creandoGrupo;
    private bool _invitando;
    private InvitacionHogarResponse? _invitacionRecibida;
    private InvitacionHogarResponse? _invitacionEnviada;
    private List<MetaResponse> _metas = [];
    private List<AportePorUsuario> _aportesPorUsuario = [];

    private readonly CrearHogarFormModel _crearHogarForm = new();
    private readonly CrearMetaFormModel _crearMetaForm = new();

    /// <summary>
    /// Los que casi todo el mundo elige, para no abrir un teclado de emojis
    /// completo por algo que se decide en un segundo.
    /// </summary>


    protected override async Task OnInitializedAsync()
    {
        await CargarAsync();
    }

    private void IrAMeta(int metaId) => Nav.NavigateTo($"/metas/{metaId}");

    private void AbrirFormNuevaMeta()
    {
        _error = null;
        _crearMetaForm.Nombre = "";
        _crearMetaForm.MontoObjetivo = null;
        _mostrandoFormNuevaMeta = true;
    }



    private async Task CargarAsync()
    {
        _cargando = true;

        _misGrupos = await Api.ObtenerMisHogaresAsync();
        // Se conserva el grupo que se estaba viendo tras crear otro o
        // recargar; si no hay ninguno elegido, el primero.
        _hogar = _misGrupos.FirstOrDefault(g => g.Id == _hogar?.Id) ?? _misGrupos.FirstOrDefault();

        if (_hogar is not null)
        {
            _metas = await Api.ObtenerMetasAsync(_hogar.Id);
            _aportesPorUsuario = await CalcularAportesPorUsuarioAsync(_metas);
        }
        else
        {
            var misInvitaciones = await Api.ObtenerMisInvitacionesHogarAsync();
            _invitacionRecibida = misInvitaciones.Recibida;
            _invitacionEnviada = misInvitaciones.Enviada;
        }
        _mostrandoFormNuevaMeta = _metas.Count == 0;
        _cargando = false;
    }

    private async Task EnviarInvitacion()
    {
        _error = null;
        _guardando = true;

        var resultado = await Api.CrearInvitacionHogarAsync(new CrearInvitacionHogarRequest(
            _crearHogarForm.EmailPareja, _hogar?.Id));

        if (resultado.Exito)
        {
            _invitacionEnviada = resultado.Valor;
            _invitando = false;
            _crearHogarForm.EmailPareja = "";
        }
        else
        {
            _error = resultado.TodosLosErrores();
        }
        _guardando = false;
    }

    private async Task AceptarInvitacion()
    {
        if (_invitacionRecibida is null) return;
        _error = null;
        _guardando = true;

        var resultado = await Api.AceptarInvitacionHogarAsync(_invitacionRecibida.Id);

        if (resultado.Exito)
        {
            _invitacionRecibida = null;
            await CargarAsync();
            return;
        }

        _error = resultado.TodosLosErrores();
        _guardando = false;
    }

    private async Task RechazarInvitacion()
    {
        var invitacionId = _invitacionRecibida?.Id ?? _invitacionEnviada?.Id;
        if (invitacionId is null) return;

        _error = null;
        _guardando = true;

        var ok = await Api.RechazarInvitacionHogarAsync(invitacionId.Value);
        if (ok)
        {
            _invitacionRecibida = null;
            _invitacionEnviada = null;
        }
        else
        {
            _error = "No pudimos completar la acción. Intenta de nuevo.";
        }
        _guardando = false;
    }

    /// <summary>
    /// No existe un endpoint que agregue aportes de todas las metas del
    /// hogar de una — como máximo son dos metas (Apartamento + Emergencia),
    /// así que pedir el detalle de cada una y sumar en el cliente es más
    /// simple que agregar un endpoint nuevo solo para esto.
    /// </summary>
    private async Task<List<AportePorUsuario>> CalcularAportesPorUsuarioAsync(List<MetaResponse> metas)
    {
        var totales = new Dictionary<int, (string Nombre, decimal Total)>();

        // En paralelo: son metas distintas, no hay razón para esperar una
        // antes de pedir la otra.
        var detalles = await Task.WhenAll(metas.Select(m => Api.ObtenerMetaAsync(m.Id)));

        foreach (var detalle in detalles)
        {
            if (detalle is null) continue;

            foreach (var aporte in detalle.AportesPorUsuario)
            {
                var actual = totales.TryGetValue(aporte.UsuarioId, out var existente) ? existente : (aporte.UsuarioNombre, 0m);
                totales[aporte.UsuarioId] = (aporte.UsuarioNombre, actual.Item2 + aporte.TotalAportado);
            }
        }

        return totales
            .Select(kv => new AportePorUsuario(kv.Key, kv.Value.Nombre, kv.Value.Total))
            .OrderByDescending(a => a.TotalAportado)
            .ToList();
    }

    private int? _desarchivando;

    private async Task Desarchivar(int metaId)
    {
        _desarchivando = metaId;
        if (await Api.DesarchivarMetaAsync(metaId) && _hogar is not null)
        {
            _metas = await Api.ObtenerMetasAsync(_hogar.Id);
        }
        _desarchivando = null;
    }

    /// <summary>
    /// Antes no existía: un grupo solo nacía cuando alguien aceptaba una
    /// invitación, así que no se podía empezar a ahorrar sin convencer a
    /// otra persona primero. Ahora se crea y se invita cuando toque.
    /// </summary>
    private async Task CrearGrupo()
    {
        _error = null;
        _guardando = true;

        var resultado = await Api.CrearHogarAsync(
            new CrearHogarRequest(_crearHogarForm.Nombre, _crearHogarForm.AplicaTope150));

        if (resultado.Exito)
        {
            _hogar = resultado.Valor;
            _creandoGrupo = false;
            _crearHogarForm.Nombre = "";
            await CargarAsync();
        }
        else
        {
            _error = resultado.TodosLosErrores();
        }

        _guardando = false;
    }

    /// <summary>
    /// Cambiar de grupo recarga todo: las metas, los aportes y el vuelto son
    /// de cada grupo, y mezclarlos sería peor que no poder cambiar.
    /// </summary>
    private async Task CambiarGrupo(int grupoId)
    {
        if (_hogar?.Id == grupoId) { _mostrandoGrupos = false; return; }

        _hogar = _misGrupos.FirstOrDefault(g => g.Id == grupoId);
        _mostrandoGrupos = false;

        if (_hogar is not null)
        {
            _metas = await Api.ObtenerMetasAsync(_hogar.Id);
            _aportesPorUsuario = await CalcularAportesPorUsuarioAsync(_metas);
        }
    }

    private async Task CrearMeta()
    {
        if (_hogar is null) return;
        _error = null;
        _guardando = true;

        var resultado = await Api.CrearMetaAsync(_hogar.Id, new CrearMetaRequest(
            _crearMetaForm.Nombre, _crearMetaForm.MontoObjetivo ?? 0,
            _crearMetaForm.Icono, _crearMetaForm.EsFondoEmergencia, _crearMetaForm.PorcentajeRedondeo));

        if (resultado.Exito)
        {
            _metas = await Api.ObtenerMetasAsync(_hogar.Id);
            _mostrandoFormNuevaMeta = false;
        }
        else
        {
            _error = resultado.TodosLosErrores();
        }
        _guardando = false;
    }

    private class CrearHogarFormModel
    {
        public string Nombre { get; set; } = "";
        public string EmailPareja { get; set; } = "";
        public bool AplicaTope150 { get; set; }
    }

    private class CrearMetaFormModel
    {
        public string Icono { get; set; } = "🏠";
        public bool EsFondoEmergencia { get; set; }
        public decimal PorcentajeRedondeo { get; set; }
        public string Nombre { get; set; } = "";
        public decimal? MontoObjetivo { get; set; }
    }
        public decimal? PorcentajeApartamento { get; set; }
    }
}
