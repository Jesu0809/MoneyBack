@*
    Selector de ícono compartido por categorías y metas.

    Nadie escribe un emoji: se toca. Antes había un campo de texto donde
    tocaba abrir el teclado del sistema, buscar el símbolo y esperar que
    quedara el correcto — y de paso se podía escribir una frase entera y
    guardarla como "ícono".

    Se muestran siete sugeridos según lo que la persona escribió en el
    nombre, que es lo que acierta la mayoría de las veces sin abrir nada.
    El octavo botón abre el catálogo completo por categorías.
*@

<div class="stack" style="gap:8px">
    <div class="row" style="gap:6px; flex-wrap:wrap">
        @foreach (var emoji in Sugeridos.Take(7))
        {
            <button type="button" class="emoji-chip @(Valor == emoji ? "active" : "")"
                    @onclick="() => ValorChanged.InvokeAsync(emoji)">@emoji</button>
        }
        <button type="button" class="emoji-chip emoji-chip-mas" @onclick="() => _abierto = true" title="Ver todos">
            <Icon Name="plus" Size="15" />
        </button>
    </div>
</div>

@if (_abierto)
{
    <div class="fullscreen-modal">
        <div class="fullscreen-header">
            <button class="icon-btn" style="background:transparent;border:none" @onclick="() => _abierto = false">
                <Icon Name="x" Size="22" />
            </button>
            <strong>Elige un ícono</strong>
            <div style="width:40px"></div>
        </div>

        <div class="fullscreen-body">
            @foreach (var categoria in CatalogoEmojis.Categorias)
            {
                <div class="stack" style="gap:8px">
                    <span class="label">@categoria.Nombre</span>
                    <div class="emoji-grid">
                        @foreach (var emoji in categoria.Emojis)
                        {
                            <button type="button" class="emoji-chip @(Valor == emoji ? "active" : "")"
                                    @onclick="() => Elegir(emoji)">@emoji</button>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public string Valor { get; set; } = "";
    [Parameter] public EventCallback<string> ValorChanged { get; set; }
    [Parameter] public string[] Sugeridos { get; set; } = ["🎯", "🏠", "🛟", "✈️", "🚗", "🎓", "💰"];

    private bool _abierto;

    private async Task Elegir(string emoji)
    {
        _abierto = false;
        await ValorChanged.InvokeAsync(emoji);
    }
}
