@if (!string.IsNullOrEmpty(Mensaje))
{
    <div class="alert alert-@Tipo">
        <Icon Name="@IconoNombre" Size="18" />
        <span>@Mensaje</span>
    </div>
}

@code {
    [Parameter] public string? Mensaje { get; set; }
    [Parameter] public string Tipo { get; set; } = "danger";

    private string IconoNombre => Tipo switch
    {
        "warning" => "alert-triangle",
        "accent" => "check",
        _ => "alert-triangle"
    };
}
