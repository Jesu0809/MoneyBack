<div class="progress-track">
    @* Css.Numero y no el valor directo: en un teléfono en español
       "45,5%" es inválido y la barra se queda vacía. *@
    <div class="progress-fill" style="width: @(Css.Numero(_anchoAnimado))%"></div>
</div>

@code {
    [Parameter] public decimal Porcentaje { get; set; }

    private decimal _anchoAnimado;
    private decimal _ultimoValor = -1;

    protected override async Task OnParametersSetAsync()
    {
        var objetivo = Math.Clamp(Porcentaje, 0, 100);
        if (objetivo == _ultimoValor) return;
        _ultimoValor = objetivo;

        _anchoAnimado = 0;
        StateHasChanged();
        await Task.Delay(60);
        _anchoAnimado = objetivo;
        StateHasChanged();
    }
}
